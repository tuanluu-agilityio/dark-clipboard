// Vector icons (Task 414). The Windows UI font and the software renderer draw no glyph for
// symbols such as the gear or the cross, so the icons are `Path` commands, never text.
// All icons share a 24 x 24 view box and take their colour from `tint` (set from `Theme`).

import { Theme } from "theme.slint";

export enum IconKind {
    gear,
    close,
    star,
    lock,
}

export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> tint: Theme.text-muted;

    viewbox-width: 24;
    viewbox-height: 24;
    fill-rule: evenodd;
    stroke-line-cap: round;
    stroke-line-join: round;
    // Close is a stroked X; the others are filled shapes (gear and lock have holes).
    fill: root.kind == IconKind.close ? transparent : root.tint;
    stroke: root.kind == IconKind.close ? root.tint : transparent;
    stroke-width: root.kind == IconKind.close ? 2.6px : 0px;
    commands: root.kind == IconKind.gear ? "M 10.03 4.66 L 10.16 1.56 L 13.84 1.56 L 13.97 4.66 L 15.80 5.42 L 18.08 3.32 L 20.68 5.92 L 18.58 8.20 L 19.34 10.03 L 22.44 10.16 L 22.44 13.84 L 19.34 13.97 L 18.58 15.80 L 20.68 18.08 L 18.08 20.68 L 15.80 18.58 L 13.97 19.34 L 13.84 22.44 L 10.16 22.44 L 10.03 19.34 L 8.20 18.58 L 5.92 20.68 L 3.32 18.08 L 5.42 15.80 L 4.66 13.97 L 1.56 13.84 L 1.56 10.16 L 4.66 10.03 L 5.42 8.20 L 3.32 5.92 L 5.92 3.32 L 8.20 5.42 Z M 15.2 12 A 3.2 3.2 0 1 0 8.8 12 A 3.2 3.2 0 1 0 15.2 12 Z"
        : root.kind == IconKind.close ? "M 5.5 5.5 L 18.5 18.5 M 18.5 5.5 L 5.5 18.5"
        : root.kind == IconKind.star ? "M 12 2.5 L 14.53 9.52 L 21.99 9.76 L 16.09 14.33 L 18.17 21.49 L 12 17.3 L 5.83 21.49 L 7.91 14.33 L 2.01 9.76 L 9.47 9.52 Z"
        : "M 7 10.5 V 7.5 A 5 5 0 0 1 17 7.5 V 10.5 H 19.5 V 21.5 H 4.5 V 10.5 Z M 9.5 10.5 V 7.5 A 2.5 2.5 0 0 1 14.5 7.5 V 10.5 Z M 11 14 H 13 V 17.5 H 11 Z";
}
