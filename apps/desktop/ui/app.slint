import { ListView, Palette } from "std-widgets.slint";
import { Theme, Strings } from "theme.slint";
import { Icon, IconName } from "kit/icon.slint";
import { IconButton } from "kit/icon_button.slint";
import { KeyCap } from "kit/key_cap.slint";
import { Menu, MenuEntry } from "kit/menu.slint";
import { TipAlign, TooltipHub, TooltipLayer } from "kit/tooltip.slint";
import { KitGallery } from "kit/gallery.slint";
import { EmptyState } from "kit/empty_state.slint";
import { Seg, ClipRow, FileRow, Chip, ChipView, PreviewPane, DetailState, SegTab, SegmentBar, StatusHint, StatusLine, Toast } from "popup.slint";
import { PopupRow, PopupRowMetrics } from "popup_row.slint";

import { HistoryWindow, FilterItem } from "history.slint";
import { TransformPanel, ShortcutSheet, SheetLine, SheetStrings } from "transform.slint";
import { SettingsWindow, SText, AppRow, KindItem } from "settings.slint";
import { WelcomeWindow, WText } from "welcome.slint";
import { OrgStrings, OrgDialogState } from "organize.slint";

export { KitGallery, SheetLine, SheetStrings, IconName, MenuEntry, SegTab, StatusHint, Theme, Strings, Seg, ClipRow, FileRow, Chip, DetailState, HistoryWindow, FilterItem, SettingsWindow, SText, AppRow, KindItem, WelcomeWindow, WText, OrgStrings, OrgDialogState }

// The popup (Task 204): created once at start and kept hidden; shown near the cursor by the
// shortcut, the tray or `--toggle`. All data and every decision come from Rust
// (`src/ui/popup_host.rs`); this file only lays things out and forwards input.
export component MainWindow inherits Window {
    icon: @image-url("../res/window-64.png");
    title: Strings.app-name;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // 760 px with the preview side pane open; the 440 px list column never shrinks.
    width: root.detail-open && !root.pane-overlay ? 760px : 440px;
    height: 520px;
    default-font-size: 13px;

    in property <[ClipRow]> rows;
    // The extra filters that are on (Today, Rich text, ...), shown as removable chips.
    in property <[Chip]> chips;
    in property <[SegTab]> segment;
    in property <int> selected;
    // 0 rows, 1 loading, 2 empty history, 3 no results, 4 error.
    in property <int> view-state;
    in property <string> toast;
    in property <bool> toast-undo;
    in property <bool> has-selection;
    // The overlines (PINNED n / RECENT n) and the rows that start them (-1: none).
    in property <string> pinned-heading;
    in property <string> recent-heading;
    in property <int> pinned-at: -1;
    in property <int> recent-at: -1;
    // Status line: capture state (tone 1 capturing, 2 paused, 3 private, 0 off) and hints.
    in property <int> status-tone;
    in property <string> status-text;
    in property <[StatusHint]> hints;
    // The open menu (row menu or More filters): entries and the highlighted one, driven by Rust.
    in property <[MenuEntry]> menu-entries;
    in property <int> menu-highlighted;
    in property <length> menu-width: 220px;
    // Detail pane (Task 206). kind: 0 text, 1 image, 2 files, 3 masked.
    in property <bool> detail-open;
    // The monitor is too narrow for 760 px: the pane draws over the list (Task 702).
    in property <bool> pane-overlay;
    in property <DetailState> detail;
    in property <string> detail-text;
    // "Copy as..." panel (Task 404).
    in property <bool> tf-open;
    in property <[string]> tf-labels;
    in property <int> tf-selected;
    in property <string> tf-preview;
    in property <string> tf-note;
    in property <bool> tf-note-error;
    in property <bool> tf-can-copy;
    // The F1 shortcuts sheet (Task 706): open state and the two columns of lines, from Rust.
    in property <bool> sheet-open;
    in property <[SheetLine]> sheet-left;
    in property <[SheetLine]> sheet-right;
    in-out property <string> query;
    // Whole rows that fit in the list (for Page Up / Page Down).
    out property <int> page-rows: max(1, floor(clip-list.visible-height / PopupRowMetrics.height));

    callback query-edited(string);
    // Returns true when the key was handled (the search box does not see it then).
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    // A chip, the filter segment or a header button gained (true) or lost (false) the keyboard
    // focus. Header buttons are 9000..9003, the segment 9100, the More filters button 9101.
    callback chip-focus(int, bool);
    callback chip-toggled(int);
    callback row-clicked(int);
    callback row-activated(int);
    // A row action (0 copy, 1 pin or unpin, 2 more) and a right click (window coordinates).
    callback row-action(int, int);
    callback row-context(int, length, length);
    callback more-filters();
    callback menu-key(string) -> bool;
    callback menu-hovered(int);
    callback menu-activated(int);
    callback menu-dismissed();
    callback tf-chosen(int);
    callback tf-copy();
    callback tf-cancel();
    callback sheet-close();
    callback act-undo();
    callback act-close();
    callback act-settings();
    callback act-history();
    callback act-preview();
    callback act-plain();
    callback act-transform();
    callback load-full-text();
    callback load-full-image();
    // The last row index on screen changed (Rust loads the next page near the end).
    callback shown-until(int);

    public function focus-search() {
        search.focus();
    }

    public function select-search() {
        search.select-all();
    }

    // A tooltip must not flash on the next show.
    public function reset-tooltip() {
        TooltipHub.shown = false;
    }

    // Opens the open-menu entries at a window position (right click).
    public function open-menu-at(x: length, y: length) {
        menu.open(x, y);
    }

    // Opens them under the selected row (keys and the row's more button).
    public function open-row-menu() {
        menu.open(clip-list.absolute-position.x + clip-list.width - menu.menu-width - 4px,
            clip-list.absolute-position.y + root.row-top(root.selected) + root.cell-height(root.selected) + clip-list.content-y);
    }

    // Opens them under the More filters button.
    public function open-more-menu() {
        menu.open(more-btn.absolute-position.x + more-btn.width - menu.menu-width,
            more-btn.absolute-position.y + more-btn.height + 4px);
    }

    public function close-menu() {
        menu.close();
    }

    // Top of row `i` in the list: rows are 48 px, plus 22 px for each overline above it.
    function row-top(i: int) -> length {
        return i * PopupRowMetrics.height
            + ((root.pinned-at >= 0 && root.pinned-at < i) ? PopupRowMetrics.section-height : 0px)
            + ((root.recent-at >= 0 && root.recent-at < i) ? PopupRowMetrics.section-height : 0px);
    }

    function cell-height(i: int) -> length {
        return PopupRowMetrics.height
            + ((i == root.pinned-at || i == root.recent-at) ? PopupRowMetrics.section-height : 0px);
    }

    // Scrolls the list so that row `i` is visible.
    public function scroll-to(i: int) {
        if (i <= 0) {
            clip-list.content-y = 0;
            return;
        }
        if (root.row-top(i) < -clip-list.content-y) {
            clip-list.content-y = -root.row-top(i);
        } else if (root.row-top(i) + root.cell-height(i) > -clip-list.content-y + clip-list.visible-height) {
            clip-list.content-y = -(root.row-top(i) + root.cell-height(i) - clip-list.visible-height);
        }
    }

    function report-shown() {
        root.shown-until(floor((-clip-list.content-y + clip-list.visible-height) / PopupRowMetrics.height));
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Sees every key before the focused element (`capture-key-pressed`), never takes focus.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, search.has-focus)) {
                return accept;
            }
            reject
        }

        panel := Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;

            VerticalLayout {
                x: 0px;
                width: 440px;
                height: parent.height;
                spacing: 0px;

                // Header (48 px): search field and the four buttons.
                HorizontalLayout {
                    height: 48px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: search.has-focus ? Theme.accent : Theme.border-strong;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: IconName.search;
                                        tint: Theme.text-2;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    search := TextInput {
                                        single-line: true;
                                        text <=> root.query;
                                        color: Theme.text;
                                        selection-background-color: Theme.accent;
                                        selection-foreground-color: Theme.bg;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        accessible-label: Strings.search-label;
                                        accessible-placeholder-text: Strings.search-hint;
                                        accessible-description: Strings.key-hints;
                                        edited => {
                                            root.query-edited(self.text);
                                        }
                                    }
                                    Text {
                                        visible: root.query == "";
                                        text: Strings.search-hint;
                                        color: Theme.text-3;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        width: 100%;
                                        accessible-role: none;
                                    }
                                }
                                if root.query == "": VerticalLayout {
                                    alignment: center;
                                    KeyCap {
                                        text: Strings.key-ctrl-k;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            name: IconName.panel-right;
                            label: Strings.tip-preview;
                            description: Strings.key-space;
                            shortcut: Strings.key-space;
                            active: root.detail-open;
                            changed has-focus => {
                                root.chip-focus(9000, self.has-focus);
                            }
                            clicked => {
                                root.act-preview();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            name: IconName.history;
                            label: Strings.tip-history;
                            description: Strings.key-ctrl-h;
                            shortcut: Strings.key-ctrl-h;
                            changed has-focus => {
                                root.chip-focus(9001, self.has-focus);
                            }
                            clicked => {
                                root.act-history();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            name: IconName.settings;
                            label: Strings.settings-open;
                            description: Strings.key-ctrl-comma;
                            tooltip: Strings.tip-settings;
                            shortcut: Strings.key-ctrl-comma;
                            tip-align: TipAlign.end;
                            changed has-focus => {
                                root.chip-focus(9002, self.has-focus);
                            }
                            clicked => {
                                root.act-settings();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            name: IconName.x;
                            label: Strings.close;
                            description: Strings.key-esc;
                            tooltip: Strings.tip-close;
                            shortcut: Strings.key-esc;
                            tip-align: TipAlign.end;
                            changed has-focus => {
                                root.chip-focus(9003, self.has-focus);
                            }
                            clicked => {
                                root.act-close();
                            }
                        }
                    }
                }

                // Filter segment (30 px), the More filters button and the active extras.
                HorizontalLayout {
                    height: 34px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 4px;
                    spacing: 4px;

                    SegmentBar {
                        tabs: root.segment;
                        group-label: Strings.filters-label;
                        toggled(id) => {
                            root.chip-toggled(id);
                        }
                        focus-report(on) => {
                            root.chip-focus(9100, on);
                        }
                    }
                    more-btn := IconButton {
                        name: IconName.chevron-down;
                        label: Strings.more-filters;
                        tooltip: Strings.more-filters;
                        changed has-focus => {
                            root.chip-focus(9101, self.has-focus);
                        }
                        clicked => {
                            root.more-filters();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 4px;
                            for c in root.chips: VerticalLayout {
                                alignment: center;
                                ChipView {
                                    chip: c;
                                    toggled => {
                                        root.chip-toggled(c.id);
                                    }
                                    focus-report(on) => {
                                        root.chip-focus(c.id, on);
                                    }
                                }
                            }
                        }
                    }
                }

                // The list, or a state message in its place. The toast floats over its bottom.
                Rectangle {
                    vertical-stretch: 1;

                    list-focus := FocusScope {
                        focus-on-click: false;
                        accessible-role: list;
                        accessible-label: Strings.list-label;
                        accessible-item-count: root.rows.length;
                        visible: root.view-state == 0;

                        Rectangle {
                            x: 4px;
                            width: parent.width - 8px;
                            border-radius: 6px;
                            border-width: list-focus.has-focus ? 1px : 0px;
                            border-color: Theme.focus;
                        }

                        clip-list := ListView {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            for r[i] in root.rows: PopupRow {
                                data: r;
                                index: i;
                                selected: i == root.selected;
                                heading: r.section == 1 ? root.pinned-heading : root.recent-heading;
                                copy-label: Strings.copy;
                                pin-label: r.pinned ? Strings.unpin : Strings.pin;
                                more-label: Strings.row-more;
                                clicked => {
                                    root.row-clicked(i);
                                }
                                activated => {
                                    root.row-activated(i);
                                }
                                context(x, y) => {
                                    root.row-context(i, x, y);
                                }
                                action(a) => {
                                    root.row-action(i, a);
                                }
                            }
                            changed content-y => {
                                root.report-shown();
                            }
                            changed visible-height => {
                                root.report-shown();
                            }
                        }
                    }

                    if root.view-state == 1: Text {
                        width: parent.width - 40px;
                        x: 20px;
                        text: Strings.loading;
                        color: Theme.text-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    // Empty history, no results, load error (Task 706).
                    if root.view-state >= 2: EmptyState {
                        width: parent.width;
                        height: parent.height;
                        icon: root.view-state == 2 ? IconName.clipboard-paste
                            : root.view-state == 3 ? IconName.search
                            : IconName.info;
                        text: root.view-state == 2 ? Strings.empty-history
                            : root.view-state == 3 ? Strings.no-results
                            : Strings.load-failed;
                        hint: root.view-state == 2 ? SheetStrings.hint-empty
                            : root.view-state == 3 ? SheetStrings.hint-no-results
                            : SheetStrings.hint-failed;
                        danger: root.view-state == 4;
                    }

                    if root.toast != "": Toast {
                        x: 12px;
                        y: parent.height - self.height - 12px;
                        width: parent.width - 24px;
                        text: root.toast;
                        undo: root.toast-undo;
                        undo-label: Strings.undo;
                        undo-key: Strings.key-ctrl-z;
                        undo-clicked => {
                            root.act-undo();
                        }
                    }
                }

                // Status line (30 px): capture state and key hints. No text footer buttons.
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                StatusLine {
                    tone: root.status-tone;
                    text: root.status-text;
                    hints: root.hints;
                    tip: SheetStrings.tip;
                    tip-key: SheetStrings.tip-key;
                }
            }

            // The preview pane (Task 702): beside the list when the window is wide, over the
            // list on a monitor narrower than 760 px. An in-tree layer, never a PopupWindow.
            if root.detail-open && root.has-selection && !root.pane-overlay: Rectangle {
                x: 440px;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }
            if root.detail-open && root.has-selection: PreviewPane {
                x: root.pane-overlay ? parent.width - 320px - 12px : 441px;
                y: 0px;
                width: root.pane-overlay ? 320px : parent.width - 441px;
                height: parent.height;
                state: root.detail;
                text: root.detail-text;
                load-text => {
                    root.load-full-text();
                }
                load-image => {
                    root.load-full-image();
                }
                plain => {
                    root.act-plain();
                }
                transform => {
                    root.act-transform();
                }
            }
        }
    }

    // The row menu and More filters: an in-window menu whose keys Rust decides (D-079, F-31).
    menu := Menu {
        // Anchor at the window origin: `open(x, y)` takes window positions.
        x: 0px;
        y: 0px;
        entries: root.menu-entries;
        menu-width: root.menu-width;
        highlighted: root.menu-highlighted;
        key(text) => {
            return root.menu-key(text);
        }
        hovered(i) => {
            root.menu-hovered(i);
        }
        activated(i) => {
            root.menu-activated(i);
        }
        dismissed => {
            root.menu-dismissed();
        }
    }

    // "Copy as..." (Task 404): covers the popup and takes every click; keys are Rust's.
    if root.tf-open: TransformPanel {
        border-radius: 10px;
        labels: root.tf-labels;
        selected: root.tf-selected;
        preview: root.tf-preview;
        note: root.tf-note;
        note-is-error: root.tf-note-error;
        can-copy: root.tf-can-copy;
        chosen(i) => {
            root.tf-chosen(i);
        }
        copy => {
            root.tf-copy();
        }
        cancel => {
            root.tf-cancel();
        }
    }

    // The F1 shortcuts sheet (Task 706): an in-window overlay over everything but the tooltip.
    // Rust owns its open state and its keys (`src/shortcuts.rs`).
    ShortcutSheet {
        border-radius: 10px;
        open: root.sheet-open;
        title: SheetStrings.title;
        footer: SheetStrings.footer;
        left: root.sheet-left;
        right: root.sheet-right;
        closed => {
            root.sheet-close();
        }
    }

    // The tooltip bubble: last, so it draws above everything (Task 700).
    TooltipLayer { }
}
