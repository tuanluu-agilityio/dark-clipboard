import { ListView, Palette } from "std-widgets.slint";
import { Theme, Strings } from "theme.slint";
import { Seg, ClipRow, FileRow, Chip, ChipView, ActionButton, RowView, DetailPane, DetailState, RowMetrics } from "popup.slint";

import { HistoryWindow, FilterItem } from "history.slint";
import { SettingsWindow, SText, AppRow, KindItem } from "settings.slint";
import { WelcomeWindow, WText } from "welcome.slint";

export { Theme, Strings, Seg, ClipRow, FileRow, Chip, DetailState, HistoryWindow, FilterItem, SettingsWindow, SText, AppRow, KindItem, WelcomeWindow, WText }

// The popup (Task 204): created once at start and kept hidden; shown near the cursor by the
// shortcut, the tray or `--toggle`. All data and every decision come from Rust
// (`src/ui/popup_host.rs`); this file only lays things out and forwards input.
export component MainWindow inherits Window {
    title: Strings.app-name;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 420px;
    height: 560px;
    default-font-size: 13px;

    in property <[ClipRow]> rows;
    in property <[Chip]> chips;
    in property <int> selected;
    // 0 rows, 1 loading, 2 empty history, 3 no results, 4 error.
    in property <int> view-state;
    in property <string> toast;
    in property <bool> toast-undo;
    in property <bool> selected-pinned;
    in property <bool> has-selection;
    // Detail pane (Task 206). kind: 0 text, 1 image, 2 files, 3 masked.
    in property <bool> detail-open;
    in property <DetailState> detail;
    in property <string> detail-text;
    in-out property <string> query;
    // Whole rows that fit in the list (for Page Up / Page Down).
    out property <int> page-rows: max(1, floor(clip-list.visible-height / RowMetrics.height));

    callback query-edited(string);
    // Returns true when the key was handled (the search box does not see it then).
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    // A chip gained (true) or lost (false) the keyboard focus.
    callback chip-focus(int, bool);
    callback chip-toggled(int);
    callback row-clicked(int);
    callback row-activated(int);
    callback act-copy();
    callback act-copy-plain();
    callback act-pin();
    callback act-delete();
    callback act-undo();
    callback act-close();
    callback act-settings();
    callback load-full-text();
    callback load-full-image();
    // The last row index on screen changed (Rust loads the next page near the end).
    callback shown-until(int);

    public function focus-search() {
        search.focus();
    }

    // Scrolls the list so that row `i` is visible.
    public function scroll-to(i: int) {
        if (i <= 0) {
            clip-list.content-y = 0;
            return;
        }
        if (i * RowMetrics.height < -clip-list.content-y) {
            clip-list.content-y = -(i * RowMetrics.height);
        } else if ((i + 1) * RowMetrics.height > -clip-list.content-y + clip-list.visible-height) {
            clip-list.content-y = -((i + 1) * RowMetrics.height - clip-list.visible-height);
        }
    }

    function report-shown() {
        root.shown-until(floor((-clip-list.content-y + clip-list.visible-height) / RowMetrics.height));
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Sees every key before the focused element (`capture-key-pressed`), never takes focus.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, search.has-focus)) {
                return accept;
            }
            reject
        }

        panel := Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                // Search box and close button.
                HorizontalLayout {
                    spacing: 6px;
                    height: 36px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: search.has-focus ? Theme.accent : Theme.line;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Rectangle {
                                search := TextInput {
                                    single-line: true;
                                    text <=> root.query;
                                    color: Theme.text;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: Theme.bg;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    accessible-label: Strings.search-label;
                                    accessible-placeholder-text: Strings.search-placeholder;
                                    accessible-description: Strings.key-hints;
                                    edited => {
                                        root.query-edited(self.text);
                                    }
                                }
                                Text {
                                    visible: root.query == "";
                                    text: Strings.search-placeholder;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    width: 100%;
                                    accessible-role: none;
                                }
                            }
                        }
                    }

                    ActionButton {
                        text: "⚙";
                        width: 32px;
                        height: 36px;
                        accessible-label: Strings.settings-open;
                        clicked => {
                            root.act-settings();
                        }
                    }

                    ActionButton {
                        text: "✕";
                        width: 32px;
                        height: 36px;
                        accessible-label: Strings.close;
                        clicked => {
                            root.act-close();
                        }
                    }
                }

                // Filter chips, scrolled sideways when they do not fit.
                chip-flick := Flickable {
                    height: 28px;
                    content-width: max(self.width, chip-row.preferred-width);
                    accessible-role: groupbox;
                    accessible-label: Strings.filters-label;
                    chip-row := HorizontalLayout {
                        spacing: 6px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        for c in root.chips: ChipView {
                            chip: c;
                            toggled => {
                                root.chip-toggled(c.id);
                            }
                            focused(x, w) => {
                                if (x < -chip-flick.content-x) {
                                    chip-flick.content-x = -x;
                                } else if (x + w > -chip-flick.content-x + chip-flick.width) {
                                    chip-flick.content-x = -(x + w - chip-flick.width);
                                }
                            }
                            focus-report(on) => {
                                root.chip-focus(c.id, on);
                            }
                        }
                    }
                }

                // The list, or a state message in its place.
                Rectangle {
                    vertical-stretch: 1;

                    list-focus := FocusScope {
                        focus-on-click: false;
                        accessible-role: list;
                        accessible-label: Strings.list-label;
                        accessible-item-count: root.rows.length;
                        visible: root.view-state == 0;

                        Rectangle {
                            border-radius: 6px;
                            border-width: list-focus.has-focus ? 1px : 0px;
                            border-color: Theme.accent;
                        }

                        clip-list := ListView {
                            for r[i] in root.rows: RowView {
                                data: r;
                                index: i;
                                selected: i == root.selected;
                                clicked => {
                                    root.row-clicked(i);
                                }
                                activated => {
                                    root.row-activated(i);
                                }
                            }
                            changed content-y => {
                                root.report-shown();
                            }
                            changed visible-height => {
                                root.report-shown();
                            }
                        }
                    }

                    Text {
                        visible: root.view-state != 0;
                        width: parent.width - 40px;
                        text: root.view-state == 1 ? Strings.loading
                            : root.view-state == 2 ? Strings.empty-history
                            : root.view-state == 3 ? Strings.no-results
                            : Strings.load-failed;
                        color: root.view-state == 4 ? Theme.danger : Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Detail of the selected clip (toggle with Right or Space).
                if root.detail-open && root.has-selection: DetailPane {
                    height: 220px;
                    state: root.detail;
                    text: root.detail-text;
                    load-text => {
                        root.load-full-text();
                    }
                    load-image => {
                        root.load-full-image();
                    }
                }

                // Footer: actions for the selected clip, or the toast (with Undo).
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                if root.toast == "": HorizontalLayout {
                    height: 28px;
                    spacing: 4px;

                    ActionButton {
                        text: Strings.copy;
                        visible: root.has-selection;
                        clicked => {
                            root.act-copy();
                        }
                    }
                    ActionButton {
                        text: Strings.copy-plain;
                        visible: root.has-selection;
                        clicked => {
                            root.act-copy-plain();
                        }
                    }
                    ActionButton {
                        text: root.selected-pinned ? Strings.unpin : Strings.pin;
                        visible: root.has-selection;
                        clicked => {
                            root.act-pin();
                        }
                    }
                    ActionButton {
                        text: Strings.delete;
                        visible: root.has-selection;
                        clicked => {
                            root.act-delete();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                if root.toast != "": HorizontalLayout {
                    height: 28px;
                    spacing: 8px;

                    Text {
                        text: root.toast;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        accessible-role: text;
                    }
                    ActionButton {
                        text: Strings.undo;
                        visible: root.toast-undo;
                        clicked => {
                            root.act-undo();
                        }
                    }
                }
            }
        }
    }
}
