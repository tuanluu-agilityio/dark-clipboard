// Dark palette (D-037: dark only). The values are set from `src/theme.rs` at start-up, which is
// the single source of truth; the defaults below only matter before that call.
export global Theme {
    in property <color> bg: #1C1E22;
    in property <color> surface: #24272C;
    in property <color> line: #383C43;
    in property <color> text: #E7E9EC;
    in property <color> text-muted: #A3A9B2;
    in property <color> accent: #4C8DFF;
    in property <color> danger: #FF7B72;
    in property <color> success: #4ADE80;
    in property <color> warning: #F5C04A;
    // Monospace font for code clips; set from src/theme.rs (a different face per OS).
    in property <string> mono-font: "Consolas";
}

// Every user-visible string is set from Rust (`darkclip_core::i18n`), never written here.
export global Strings {
    in property <string> app-name;
    in property <string> placeholder;
    in property <string> status;
    // Empty when the global shortcut works; otherwise why it does not (shown in settings).
    in property <string> shortcut-warning;
    // Popup (Task 204)
    in property <string> search-placeholder;
    in property <string> search-label;
    in property <string> filters-label;
    in property <string> list-label;
    in property <string> empty-history;
    in property <string> no-results;
    in property <string> loading;
    in property <string> load-failed;
    in property <string> copy;
    in property <string> copy-plain;
    in property <string> pin;
    in property <string> unpin;
    in property <string> delete;
    in property <string> undo;
    in property <string> close;
    in property <string> key-hints;
    // Previews and item detail (Task 206)
    in property <string> detail-label;
    in property <string> load-full-text;
    in property <string> load-larger-image;
    in property <string> no-image-preview;
    in property <string> masked-detail;
    in property <string> text-cut;
    // History window (Task 211)
    in property <string> history-title;
    in property <string> select-all;
    in property <string> clear-selection;
    in property <string> cancel;
    in property <string> history-hint;
    in property <string> confirm-hints;
}
