// Dark palette (D-037: dark only), tokens of `docs/specs/ui-redesign/02-design-system.md`
// section 2. The values are set from `src/theme.rs` at start-up, which is the single source of
// truth; the defaults below only matter before that call. The old names (bg, line, text-muted)
// are aliases of the new tokens, so every window written before Task 700 follows the palette.
export global Theme {
    in property <color> canvas: #111318;
    in property <color> surface: #1B2028;
    in property <color> raised: #232935;
    in property <color> selected: #262C45;
    in property <color> border: #2D3440;
    in property <color> border-strong: #4A5263;
    in property <color> text: #F3F5F9;
    in property <color> text-2: #A1AAB8;
    in property <color> text-3: #8F98A8;
    in property <color> accent: #7887FF;
    in property <color> on-accent: #111318;
    in property <color> focus: #9AA6FF;
    in property <color> success: #5FD4AA;
    in property <color> warning: #F2C14E;
    in property <color> danger: #FF7A85;
    // Aliases (old name -> token): bg -> canvas, line -> border, text-muted -> text-2.
    out property <color> bg: self.canvas;
    out property <color> line: self.border;
    out property <color> text-muted: self.text-2;
    // Monospace font for code clips; set from src/theme.rs (a different face per OS).
    in property <string> mono-font: "Consolas";
}

// Every user-visible string is set from Rust (`darkclip_core::i18n`), never written here.
export global Strings {
    in property <string> app-name;
    in property <string> placeholder;
    in property <string> status;
    // Empty when the global shortcut works; otherwise why it does not (shown in settings).
    in property <string> shortcut-warning;
    // Popup (Task 204)
    in property <string> search-placeholder;
    in property <string> search-label;
    in property <string> filters-label;
    in property <string> list-label;
    in property <string> empty-history;
    in property <string> no-results;
    in property <string> loading;
    in property <string> load-failed;
    in property <string> copy;
    in property <string> copy-plain;
    in property <string> pin;
    in property <string> unpin;
    in property <string> delete;
    in property <string> undo;
    in property <string> close;
    in property <string> key-hints;
    // Previews and item detail (Task 206)
    in property <string> detail-label;
    in property <string> load-full-text;
    in property <string> load-larger-image;
    in property <string> no-image-preview;
    in property <string> masked-detail;
    in property <string> text-cut;
    // Transforms and edited copies (Task 404)
    in property <string> copy-as;
    // Short footer labels; the accessible labels keep the full text.
    in property <string> footer-copy-plain;
    in property <string> footer-copy-as;
    in property <string> tf-result;
    in property <string> tf-hint;
    in property <string> edit;
    in property <string> edit-hint;
    in property <string> save-new;
    // History window (Task 211)
    in property <string> history-title;
    in property <string> select-all;
    in property <string> clear-selection;
    in property <string> cancel;
    in property <string> history-hint;
    in property <string> confirm-hints;
    // History layout (Task 703): tooltips, facts and key caps of the sidebar, toolbar and panel.
    in property <string> hist-tip-date;
    in property <string> hist-tip-select;
    in property <string> hist-tip-collapse;
    in property <string> hist-tip-expand;
    in property <string> hist-tip-edit-copy;
    in property <string> hist-fact-type;
    in property <string> hist-fact-from;
    in property <string> hist-fact-copied;
    in property <string> hist-no-collections;
    in property <string> hist-key-enter;
    in property <string> hist-key-shift-enter;
    in property <string> hist-key-ctrl-t;
    in property <string> hist-key-ctrl-e;
    in property <string> hist-key-ctrl-p;
    in property <string> hist-key-del;
    // Settings (Task 207)
    in property <string> settings-open;
    // Tooltips of the icon buttons (Task 700): name and key.
    in property <string> tip-settings;
    in property <string> tip-close;
    in property <string> tip-favorite;
    // Key caps shown in tooltips (identical in both languages).
    in property <string> key-esc;
    in property <string> key-ctrl-d;
    // Popup layout (Task 701): short search hint, header and row tooltips, key caps.
    in property <string> search-hint;
    in property <string> tip-preview;
    in property <string> tip-history;
    in property <string> more-filters;
    in property <string> row-more;
    in property <string> key-ctrl-k;
    in property <string> key-ctrl-h;
    in property <string> key-ctrl-z;
    in property <string> key-ctrl-comma;
    in property <string> key-space;
    in property <string> key-shift-enter;
    in property <string> key-ctrl-t;
}
