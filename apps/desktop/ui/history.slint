// The history window (Task 211, laid out again in Task 703): sidebar (216 px) | toolbar, list and
// status line | detail panel (340 px). Data and every decision come from Rust
// (`src/ui/history_host.rs`, which reuses the popup's view-models and `src/history/sidebar.rs`);
// this file only lays things out and forwards input. Every string comes from the `Strings` /
// `OrgStrings` globals (i18n). Dark only (D-037).
//
// The panes sit at fixed positions (not in layouts) so the Tab order is: search, date, select
// toggle, sidebar, list, detail toolbar, tags, note, collections. Narrow layouts are Task 704.

import { ListView, Palette } from "std-widgets.slint";
import { Theme, Strings } from "theme.slint";
import { Icon, IconName } from "kit/icon.slint";
import { IconButton } from "kit/icon_button.slint";
import { Button, ButtonKind } from "kit/button.slint";
import { Menu, MenuEntry as KitEntry } from "kit/menu.slint";
import { TipAlign, TooltipHub, TooltipLayer } from "kit/tooltip.slint";
import { ClipRow, DetailPane, DetailState, StatusHint } from "popup.slint";
import { TransformPanel, EditPanel } from "transform.slint";
import { OrgDialog, OrgDialogState, OrgStrings } from "organize.slint";
import { HistoryRow, HistoryRowMetrics } from "history_row.slint";
import { FilterItem, SidebarView, DateButton, DetailToolbar, ChipSection, NoteSection, FactLine, HistoryStatus } from "history_panes.slint";

export { FilterItem } from "history_panes.slint";

// One entry of the context menu.
component CtxEntry inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    background: touch.has-hover && root.enabled ? Theme.line : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: !root.enabled ? Theme.text-muted.with-alpha(0.6) : (root.danger ? Theme.danger : Theme.text);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component HistoryWindow inherits Window {
    icon: @image-url("../res/window-64.png");
    title: Strings.history-title;
    background: Theme.bg;
    // 216 px sidebar + 320 px list + 340 px panel; narrower layouts come with Task 704.
    min-width: 876px;
    min-height: 460px;
    preferred-width: 1060px;
    preferred-height: 660px;
    default-font-size: 13px;

    in property <[ClipRow]> rows;
    in property <[FilterItem]> filters;
    in property <int> selected;
    // 0 rows, 1 loading, 2 empty history, 3 no results, 4 error.
    in property <int> view-state;
    in property <string> toast;
    // The clips actions apply to: none, one or several.
    in property <bool> has-selection;
    in property <bool> can-copy;
    in property <bool> will-unpin;
    // "3 clips" when several are marked; empty otherwise.
    in property <string> summary;
    // Details (single clip only). Hidden when `detail-open` is false.
    in property <bool> detail-open;
    in property <DetailState> detail;
    in property <string> detail-text;
    // Type, source app and time of the single clip (never its content).
    in property <string> fact-type;
    in property <string> fact-from;
    in property <string> fact-copied;
    // Non-empty while the delete confirmation is open (the text it asks).
    in property <string> confirm-text;
    // "Copy as..." and "Edit..." (Task 404). `can-transform`: one text clip, not masked.
    in property <bool> can-transform;
    in property <bool> tf-open;
    in property <[string]> tf-labels;
    in property <int> tf-selected;
    in property <string> tf-preview;
    in property <string> tf-note;
    in property <bool> tf-note-error;
    in property <bool> tf-can-copy;
    in property <bool> edit-open;
    in property <string> edit-note;
    in-out property <string> edit-text;
    in-out property <string> query;
    // Toolbar (Task 703): the current filter's name, the date menu and the select-mode toggle.
    in property <string> filter-title;
    in property <string> date-text;
    in property <[KitEntry]> date-entries;
    in property <int> date-highlighted;
    in property <bool> select-mode;
    // Status line: "128 clips" and at most two key hints.
    in property <string> status-text;
    in property <[StatusHint]> status-hints;
    // Organisation (Task 403). `org-*`: what the actions offer for the selection (masked
    // clips take no add action). The sections show the one selected clip.
    in property <bool> org-strip;
    in property <bool> org-favorite;
    in property <string> org-fav-text;
    in property <bool> org-can-favorite;
    in property <bool> org-can-add;
    in property <bool> org-can-remove;
    in property <bool> org-can-edit;
    in property <string> org-note;
    in property <[string]> org-tags;
    in property <[string]> org-collections;
    // A user collection is shown: it can be renamed or deleted.
    in property <bool> col-shown;
    in property <string> confirm-label;
    in property <string> confirm-hint;
    in property <bool> dlg-open;
    in property <OrgDialogState> dlg;
    in-out property <string> dlg-text;
    // Where the context menu opens (window coordinates).
    private property <length> menu-x;
    private property <length> menu-y;
    out property <int> page-rows: max(1, floor(clip-list.visible-height / HistoryRowMetrics.height));

    callback query-edited(string);
    // Returns true when the key was handled (the search box does not see it then).
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    // A control that handles Enter, Space or the arrows itself has (or lost) the focus; Rust's key
    // map leaves those keys alone then. Ids: -101 date button, -102 select toggle, -50 sidebar,
    // -110 detail toolbar, -120 tags, -121 note, -122 collections.
    callback filter-focus(int, bool);
    callback filter-toggled(int);
    callback group-toggled(int);
    // A left click on a row with Ctrl / Shift held; a right click selects the row first.
    callback row-pressed(int, bool, bool);
    callback row-context(int);
    callback row-activated(int);
    callback act-copy();
    callback act-copy-plain();
    callback act-copy-as();
    callback act-edit();
    callback tf-chosen(int);
    callback tf-copy();
    callback tf-cancel();
    callback edit-save();
    callback edit-cancel();
    callback act-pin();
    callback act-delete();
    callback act-select-all();
    callback act-select-mode();
    callback act-confirm();
    callback act-cancel();
    callback load-full-text();
    callback load-full-image();
    callback shown-until(int);
    callback act-favorite();
    callback act-note();
    callback act-tags();
    callback act-add-collection();
    callback act-remove-collection();
    callback act-new-collection();
    callback act-rename-collection();
    callback act-delete-collection();
    callback org-remove-tag(int);
    callback org-remove-collection(int);
    callback dlg-edited(string);
    callback dlg-submit();
    callback dlg-cancel();
    callback dlg-choose(int);
    callback dlg-remove-chip(int);
    // The date menu (an in-window `Menu`: its keys are decided in Rust, D-079).
    callback date-menu-requested();
    callback date-menu-key(string) -> bool;
    callback date-menu-hovered(int);
    callback date-menu-activated(int);

    public function focus-search() {
        search.focus();
    }

    public function scroll-to(i: int) {
        if (i <= 0) {
            clip-list.content-y = 0;
            return;
        }
        if (i * HistoryRowMetrics.height < -clip-list.content-y) {
            clip-list.content-y = -(i * HistoryRowMetrics.height);
        } else if ((i + 1) * HistoryRowMetrics.height > -clip-list.content-y + clip-list.visible-height) {
            clip-list.content-y = -((i + 1) * HistoryRowMetrics.height - clip-list.visible-height);
        }
    }

    // The context menu of the selected row (Menu key).
    public function open-menu-at-selected() {
        root.menu-x = clip-list.absolute-position.x - self.absolute-position.x + 48px;
        root.menu-y = clip-list.absolute-position.y - self.absolute-position.y + root.selected * HistoryRowMetrics.height + clip-list.content-y + 40px;
        menu.show();
    }

    // Opens the date menu under the date button (Rust filled the entries first).
    public function open-date-menu() {
        date-menu.open(date-btn.absolute-position.x - self.absolute-position.x + date-btn.width - date-menu.menu-width,
            date-btn.absolute-position.y - self.absolute-position.y + date-btn.height + 4px);
    }

    public function close-date-menu() {
        date-menu.close();
    }

    // The window is hidden: no menu, no tooltip stays (the hub is per window).
    public function reset-ui() {
        date-menu.close();
        menu.close();
        TooltipHub.shown = false;
    }

    function report-shown() {
        root.shown-until(floor((-clip-list.content-y + clip-list.visible-height) / HistoryRowMetrics.height));
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Sees every key before the focused element, never takes focus.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, search.has-focus)) {
                return accept;
            }
            reject
        }

        // ---- Toolbar (48 px, over the list column) ----
        toolbar := Rectangle {
            x: 216px;
            y: 0px;
            width: parent.width - 216px - 340px;
            height: 48px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    min-width: 48px;
                    max-width: 150px;
                    Text {
                        text: root.filter-title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.text;
                    }
                }

                // Search field (popup style).
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 140px;
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: search.has-focus ? Theme.focus : Theme.border;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: IconName.search;
                                    tint: Theme.text-3;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                search := TextInput {
                                    single-line: true;
                                    text <=> root.query;
                                    color: Theme.text;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: Theme.bg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    accessible-label: Strings.search-label;
                                    accessible-placeholder-text: Strings.search-placeholder;
                                    accessible-description: Strings.key-hints;
                                    edited => {
                                        root.query-edited(self.text);
                                    }
                                }
                                Text {
                                    visible: root.query == "";
                                    text: Strings.search-placeholder;
                                    color: Theme.text-3;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    width: 100%;
                                    accessible-role: AccessibleRole.none;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    date-btn := DateButton {
                        text: root.date-text;
                        label: Strings.hist-tip-date;
                        open-requested => {
                            root.date-menu-requested();
                        }
                        focus-report(on) => {
                            root.filter-focus(-101, on);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    IconButton {
                        name: IconName.list-checks;
                        label: Strings.hist-tip-select;
                        active: root.select-mode;
                        tip-align: TipAlign.end;
                        focus-gained(reason) => {
                            root.filter-focus(-102, true);
                        }
                        focus-lost(reason) => {
                            root.filter-focus(-102, false);
                        }
                        clicked => {
                            root.act-select-mode();
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ---- Sidebar (216 px) ----
        Rectangle {
            x: 0px;
            y: 0px;
            width: 216px;
            height: parent.height;
            background: Theme.surface;

            SidebarView {
                x: 0px;
                y: 8px;
                width: parent.width - 1px;
                height: parent.height - 16px;
                items: root.filters;
                col-shown: root.col-shown;
                toggled(id) => {
                    root.filter-toggled(id);
                }
                group-toggled(g) => {
                    root.group-toggled(g);
                }
                add-clicked => {
                    root.act-new-collection();
                }
                rename-clicked => {
                    root.act-rename-collection();
                }
                delete-clicked => {
                    root.act-delete-collection();
                }
                focus-report(on) => {
                    root.filter-focus(-50, on);
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        // ---- List (flex, min 320 px) ----
        list-col := Rectangle {
            x: 216px;
            y: 48px;
            width: parent.width - 216px - 340px;
            height: parent.height - 48px - 28px;

            list-focus := FocusScope {
                focus-on-click: false;
                accessible-role: list;
                accessible-label: Strings.list-label;
                accessible-item-count: root.rows.length;
                visible: root.view-state == 0;

                Rectangle {
                    border-radius: 6px;
                    border-width: list-focus.has-focus ? 1px : 0px;
                    border-color: Theme.focus;
                }

                clip-list := ListView {
                    x: 8px;
                    width: parent.width - 16px;
                    for r[i] in root.rows: HistoryRow {
                        data: r;
                        index: i;
                        selected: i == root.selected;
                        pressed(ctrl, shift) => {
                            root.row-pressed(i, ctrl, shift);
                        }
                        context(x, y) => {
                            root.row-context(i);
                            root.menu-x = x - root.absolute-position.x;
                            root.menu-y = y - root.absolute-position.y;
                            menu.show();
                        }
                        activated => {
                            root.row-activated(i);
                        }
                    }
                    changed content-y => {
                        root.report-shown();
                    }
                    changed visible-height => {
                        root.report-shown();
                    }
                }
            }

            Text {
                visible: root.view-state != 0;
                width: parent.width - 40px;
                x: 20px;
                text: root.view-state == 1 ? Strings.loading
                    : root.view-state == 2 ? Strings.empty-history
                    : root.view-state == 3 ? Strings.no-results
                    : Strings.load-failed;
                color: root.view-state == 4 ? Theme.danger : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            // The toast floats above the status line and never hides a control.
            if root.toast != "": Rectangle {
                x: 12px;
                y: parent.height - 44px;
                width: parent.width - 24px;
                height: 36px;
                border-radius: 8px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-strong;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: IconName.info;
                            tint: Theme.text-2;
                        }
                    }
                    Text {
                        text: root.toast;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.toast;
                    }
                }
            }
        }

        // ---- Status line (28 px) ----
        HistoryStatus {
            x: 216px;
            y: parent.height - 28px;
            width: parent.width - 216px - 340px;
            text: root.status-text;
            hints: root.status-hints;
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ---- Detail panel (340 px) ----
        Rectangle {
            x: parent.width - 340px;
            y: 0px;
            width: 340px;
            height: parent.height;
            background: Theme.bg;

            Rectangle {
                x: 0px;
                width: 1px;
                background: Theme.border;
            }

            DetailToolbar {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                can-copy: root.can-copy;
                can-transform: root.can-transform;
                has-selection: root.has-selection;
                will-unpin: root.will-unpin;
                can-favorite: root.org-can-favorite;
                favorite: root.org-favorite;
                fav-text: root.org-fav-text;
                act-copy => {
                    root.act-copy();
                }
                act-copy-plain => {
                    root.act-copy-plain();
                }
                act-copy-as => {
                    root.act-copy-as();
                }
                act-edit => {
                    root.act-edit();
                }
                act-pin => {
                    root.act-pin();
                }
                act-favorite => {
                    root.act-favorite();
                }
                act-delete => {
                    root.act-delete();
                }
                focus-report(on) => {
                    root.filter-focus(-110, on);
                }
            }

            Rectangle {
                y: 47px;
                height: 1px;
                background: Theme.border;
            }

            // One clip: preview box, facts and the inline sections.
            if root.detail-open: VerticalLayout {
                y: 48px;
                height: parent.height - 48px;
                padding: 12px;
                spacing: 10px;

                // A masked clip has no preview box: only the note.
                if root.detail.kind == 3: HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    alignment: start;
                    VerticalLayout {
                        alignment: start;
                        Icon {
                            name: IconName.eye-off;
                            tint: Theme.warning;
                        }
                    }
                    Text {
                        text: root.detail.note;
                        color: Theme.text-2;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: top;
                        accessible-role: AccessibleRole.text;
                    }
                }
                if root.detail.kind != 3: DetailPane {
                    vertical-stretch: 1;
                    state: root.detail;
                    text: root.detail-text;
                    load-text => {
                        root.load-full-text();
                    }
                    load-image => {
                        root.load-full-image();
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    FactLine {
                        name: Strings.hist-fact-type;
                        value: root.fact-type;
                    }
                    FactLine {
                        visible: root.fact-from != "";
                        height: root.fact-from != "" ? 18px : 0px;
                        name: Strings.hist-fact-from;
                        value: root.fact-from;
                    }
                    FactLine {
                        name: Strings.hist-fact-copied;
                        value: root.fact-copied;
                    }
                }

                if root.org-strip && root.org-can-edit: VerticalLayout {
                    spacing: 6px;
                    ChipSection {
                        title: OrgStrings.tags-label;
                        chips: root.org-tags;
                        empty-text: OrgStrings.no-tags;
                        add-label: OrgStrings.edit-tags;
                        remove-label: OrgStrings.remove-tag;
                        add => {
                            root.act-tags();
                        }
                        remove(i) => {
                            root.org-remove-tag(i);
                        }
                        focus-report(on) => {
                            root.filter-focus(-120, on);
                        }
                    }
                    NoteSection {
                        note: root.org-note;
                        edit => {
                            root.act-note();
                        }
                        focus-report(on) => {
                            root.filter-focus(-121, on);
                        }
                    }
                    ChipSection {
                        title: OrgStrings.collections-label;
                        chips: root.org-collections;
                        empty-text: Strings.hist-no-collections;
                        add-label: OrgStrings.add-to-collection;
                        remove-label: OrgStrings.remove-from-collection;
                        add => {
                            root.act-add-collection();
                        }
                        remove(i) => {
                            root.org-remove-collection(i);
                        }
                        focus-report(on) => {
                            root.filter-focus(-122, on);
                        }
                    }
                }
            }
            // Several clips (or none): the count, and the toolbar still acts on the marks.
            if !root.detail-open: Text {
                y: 48px;
                height: parent.height - 48px;
                x: 12px;
                width: parent.width - 24px;
                text: root.summary != "" ? root.summary : Strings.history-hint;
                color: root.summary != "" ? Theme.text : Theme.text-2;
                font-size: root.summary != "" ? 18px : 13px;
                font-weight: root.summary != "" ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                accessible-role: text;
            }
        }
    }

    // The date menu: an in-window `Menu`; its keys are decided in Rust (D-079).
    date-menu := Menu {
        entries: root.date-entries;
        highlighted: root.date-highlighted;
        key(text) => {
            return root.date-menu-key(text);
        }
        hovered(i) => {
            root.date-menu-hovered(i);
        }
        activated(i) => {
            root.date-menu-activated(i);
        }
    }

    // The context menu (same actions as the detail toolbar; the keyboard keys work too).
    Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 0px;
        height: 0px;
        menu := PopupWindow {
            x: 0px;
            y: 0px;
            width: 230px;
            height: menu-col.preferred-height + 2px;
            close-policy: close-on-click-outside;
            Rectangle {
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.line;
                menu-col := VerticalLayout {
                    padding: 1px;
                    CtxEntry {
                        text: Strings.copy;
                        enabled: root.can-copy;
                        clicked => {
                            menu.close();
                            root.act-copy();
                        }
                    }
                    CtxEntry {
                        text: Strings.copy-plain;
                        enabled: root.can-copy;
                        clicked => {
                            menu.close();
                            root.act-copy-plain();
                        }
                    }
                    CtxEntry {
                        text: Strings.copy-as;
                        enabled: root.can-transform;
                        clicked => {
                            menu.close();
                            root.act-copy-as();
                        }
                    }
                    CtxEntry {
                        text: Strings.edit;
                        enabled: root.can-transform;
                        clicked => {
                            menu.close();
                            root.act-edit();
                        }
                    }
                    CtxEntry {
                        text: root.will-unpin ? Strings.unpin : Strings.pin;
                        enabled: root.has-selection;
                        clicked => {
                            menu.close();
                            root.act-pin();
                        }
                    }
                    CtxEntry {
                        text: Strings.delete;
                        danger: true;
                        enabled: root.has-selection;
                        clicked => {
                            menu.close();
                            root.act-delete();
                        }
                    }
                    CtxEntry {
                        text: root.org-fav-text;
                        enabled: root.org-can-favorite;
                        clicked => {
                            menu.close();
                            root.act-favorite();
                        }
                    }
                    CtxEntry {
                        text: OrgStrings.add-to-collection;
                        enabled: root.org-can-add;
                        clicked => {
                            menu.close();
                            root.act-add-collection();
                        }
                    }
                    CtxEntry {
                        text: OrgStrings.remove-from-collection;
                        enabled: root.org-can-remove;
                        clicked => {
                            menu.close();
                            root.act-remove-collection();
                        }
                    }
                    CtxEntry {
                        text: OrgStrings.edit-tags;
                        enabled: root.org-can-add;
                        clicked => {
                            menu.close();
                            root.act-tags();
                        }
                    }
                    CtxEntry {
                        text: OrgStrings.edit-note;
                        enabled: root.org-can-edit;
                        clicked => {
                            menu.close();
                            root.act-note();
                        }
                    }
                    CtxEntry {
                        text: Strings.select-all;
                        clicked => {
                            menu.close();
                            root.act-select-all();
                        }
                    }
                }
            }
        }
    }

    // The delete confirmation: modal (it covers the window and takes every click).
    if root.confirm-text != "": Rectangle {
        background: #000000a0;
        accessible-role: groupbox;
        accessible-label: root.confirm-text;

        TouchArea {}

        Rectangle {
            width: min(420px, parent.width - 40px);
            height: dialog-col.preferred-height + 32px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;

            dialog-col := VerticalLayout {
                padding: 16px;
                spacing: 16px;
                Text {
                    text: root.confirm-text;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    height: 32px;
                    Button {
                        text: Strings.cancel;
                        clicked => {
                            root.act-cancel();
                        }
                    }
                    Button {
                        text: root.confirm-label;
                        kind: root.confirm-label == Strings.delete ? ButtonKind.danger : ButtonKind.primary;
                        clicked => {
                            root.act-confirm();
                        }
                    }
                }
            }
        }
    }

    // The organisation dialog (Task 403): covers the window and takes every click.
    // The text box inside has the focus, so the keys are forwarded from this scope (a
    // `capture-key-pressed` only sees keys of the focused item's ancestors).
    if root.dlg-open: FocusScope {
        focus-on-click: false;
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, false)) {
                return accept;
            }
            reject
        }
        OrgDialog {
            state: root.dlg;
            text <=> root.dlg-text;
            edited(s) => {
                root.dlg-edited(s);
            }
            submit => {
                root.dlg-submit();
            }
            cancel => {
                root.dlg-cancel();
            }
            choose(i) => {
                root.dlg-choose(i);
            }
            remove-chip(i) => {
                root.dlg-remove-chip(i);
            }
        }
    }

    // "Copy as..." and "Edit..." (Task 404): each covers the window and takes every click.
    if root.tf-open: TransformPanel {
        labels: root.tf-labels;
        selected: root.tf-selected;
        preview: root.tf-preview;
        note: root.tf-note;
        note-is-error: root.tf-note-error;
        can-copy: root.tf-can-copy;
        chosen(i) => {
            root.tf-chosen(i);
        }
        copy => {
            root.tf-copy();
        }
        cancel => {
            root.tf-cancel();
        }
    }

    // Same reason as the organisation dialog: the editor's text box has the focus.
    if root.edit-open: FocusScope {
        focus-on-click: false;
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, false)) {
                return accept;
            }
            reject
        }
        EditPanel {
            text <=> root.edit-text;
            note: root.edit-note;
            save => {
                root.edit-save();
            }
            cancel => {
                root.edit-cancel();
            }
        }
    }

    // The tooltip bubble: always the last child, above the menus and dialogs.
    TooltipLayer { }
}
