// Popup building blocks (Tasks 204 and 206). Data comes from Rust (`src/ui/popup_host.rs`);
// every string comes from the `Strings` global (i18n). Dark only (D-037).

import { ScrollView } from "std-widgets.slint";
import { Theme, Strings } from "theme.slint";
import { Icon, IconName } from "kit/icon.slint";
import { Button, ButtonKind } from "kit/button.slint";
import { KeyCap } from "kit/key_cap.slint";
import { Tooltip, TipAlign } from "kit/tooltip.slint";
import { IconButton } from "kit/icon_button.slint";

// One piece of a preview line; `hit` pieces matched the search.
export struct Seg {
    text: string,
    hit: bool,
}

// One row of the list (Task 206): a kind icon, a two-line preview (already cut and split into
// pieces in Rust; `mono` for code), a line of details (number, kind, source app, time), badges
// and the plain texts for screen readers.
export struct ClipRow {
    segs: [Seg],
    segs2: [Seg],
    meta: string,
    label: string,
    description: string,
    icon: string,
    // Empty when the clip is not pinned / not masked.
    pin-badge: string,
    // A star for a favorite (Task 403); empty otherwise.
    favorite: bool,
    masked-badge: string,
    mono: bool,
    pinned: bool,
    // Marked for a multi-selection (history window, Task 211); false in the popup.
    marked: bool,
    // The popup row (Task 701): kind icon, Alt+N number ("1".."9", empty after), overline (0 none,
    // 1 first pinned, 2 first recent) and the masked flag. The history rows ignore them.
    kind-icon: IconName,
    number: string,
    section: int,
    masked: bool,
}

// One file of a file clip.
export struct FileRow {
    name: string,
    path: string,
}

// One label and value of the preview pane's facts block (Task 702).
export struct FactRow {
    label: string,
    value: string,
}

// What the detail pane shows (Task 206; one struct so the popup and the history window set it
// the same way). `kind`: 0 text, 1 image, 2 files, 3 masked. `note`: the masked note, or "no
// preview image". `status`: loading or failure message, or the cut-text note. The text is a separate pane property.
export struct DetailState {
    kind: int,
    title: string,
    note: string,
    status: string,
    can-load-text: bool,
    picture: image,
    has-picture: bool,
    picture-info: string,
    can-load-image: bool,
    files: [FileRow],
    files-more: string,
    mono: bool,
    // The preview pane's header buttons (Task 702) and its facts block.
    can-transform: bool,
    can-plain: bool,
    facts: [FactRow],
}

// A filter chip. `id` is opaque to the markup (Rust decides what it means).
export struct Chip {
    id: int,
    label: string,
    on: bool,
}

export global RowMetrics {
    out property <length> height: 68px;
}

export component ChipView inherits FocusScope {
    in property <Chip> chip;
    callback toggled();
    callback focused(length, length);
    // Every focus change, so Rust knows which chip has the focus (Enter/Space toggle it).
    callback focus-report(bool);

    focus-on-click: false;
    height: 26px;
    // Extras shrink (the label elides) when the segment leaves little room.
    min-width: 56px;
    preferred-width: label.preferred-width + (chip.on ? 38px : 22px);
    max-width: 120px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: chip.on;
    accessible-label: chip.label;
    accessible-action-default => {
        root.toggled();
    }

    key-pressed(e) => {
        if (e.text == " " || e.text == Key.Return) {
            root.toggled();
            return accept;
        }
        reject
    }
    focus-gained(reason) => {
        root.focused(self.x, self.width);
        root.focus-report(true);
    }
    focus-lost(reason) => {
        root.focus-report(false);
    }

    // An active extra filter (Task 701): a removable chip, `x` takes it off.
    Rectangle {
        border-radius: 13px;
        background: chip.on ? Theme.selected : (touch.has-hover ? Theme.raised : Theme.surface);
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.focus : (chip.on ? Theme.accent : Theme.border);
        HorizontalLayout {
            padding-left: 10px;
            padding-right: chip.on ? 6px : 10px;
            spacing: 4px;
            label := Text {
                text: chip.label;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if chip.on: VerticalLayout {
                alignment: center;
                Icon {
                    name: IconName.x;
                    size: 12px;
                    tint: Theme.text-2;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 26px;
    min-width: label.preferred-width + 16px;
    border-radius: 5px;
    background: touch.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        text: root.text;
        color: touch.has-hover ? Theme.text : Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A small pill (pinned, masked).
component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 15px;
    min-width: label.preferred-width + 10px;
    border-radius: 7.5px;
    border-width: 1px;
    border-color: root.tint;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RowView inherits Rectangle {
    in property <ClipRow> data;
    in property <bool> selected;
    in property <int> index;
    callback clicked();
    callback activated();
    // History window (Task 211): a left click with its modifiers, and a right click (window
    // coordinates of the pointer).
    callback pressed(bool, bool);
    callback context(length, length);

    height: RowMetrics.height;
    border-radius: 6px;
    background: data.marked ? Theme.accent.with-alpha(selected ? 0.34 : 0.22)
        : selected ? Theme.surface
        : (touch.has-hover ? Theme.surface.with-alpha(0.5) : transparent);
    accessible-role: list-item;
    accessible-label: data.label;
    accessible-description: data.description;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected || data.marked;
    accessible-item-index: root.index;
    accessible-action-default => {
        root.activated();
    }

    // Pinned clips carry an accent bar on the left.
    Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
        visible: data.pinned;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        // Kind icon.
        Rectangle {
            width: 30px;
            height: 30px;
            y: 4px;
            border-radius: 6px;
            background: Theme.line;
            Text {
                text: data.icon;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            // The two preview lines: pieces side by side, cut at the right edge.
            for lines in [data.segs, data.segs2]: Rectangle {
                height: 18px;
                min-width: 0px;
                clip: true;
                HorizontalLayout {
                    alignment: start;
                    spacing: 0px;
                    for s in lines: Text {
                        text: s.text;
                        min-width: self.preferred-width;
                        color: s.hit ? Theme.accent : Theme.text;
                        font-weight: s.hit ? 700 : 400;
                        font-size: 13px;
                        font-family: data.mono ? Theme.mono-font : "";
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                height: 16px;
                Text {
                    text: data.meta;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                if data.favorite: VerticalLayout {
                    width: 13px;
                    alignment: center;
                    Icon {
                        name: IconName.star;
                        tint: Theme.warning;
                        size: 13px;
                    }
                }
                if data.pin-badge != "": Badge {
                    text: data.pin-badge;
                    tint: Theme.accent;
                }
                if data.masked-badge != "": Badge {
                    text: data.masked-badge;
                    tint: Theme.warning;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                if (e.button == PointerEventButton.left) {
                    root.pressed(e.modifiers.control, e.modifiers.shift);
                } else if (e.button == PointerEventButton.right) {
                    root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// The detail pane (Tasks 206 and 211). `kind`: 0 text, 1 image, 2 files, 3 masked. Every
// text comes from Rust. A masked clip shows only the note: no content is ever passed here.
export component DetailPane inherits Rectangle {
    in property <DetailState> state;
    // Kept out of `state` so the host can leave it alone when it did not change (a large text
    // is laid out again whenever it is set).
    in property <string> text;
    callback load-text();
    callback load-image();

    border-radius: 6px;
    background: Theme.surface;
    accessible-role: groupbox;
    accessible-label: root.state.title;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            Text {
                text: root.state.title;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.state.kind == 0 && root.state.can-load-text: ActionButton {
                text: Strings.load-full-text;
                clicked => {
                    root.load-text();
                }
            }
            if root.state.kind == 1 && root.state.can-load-image: ActionButton {
                text: Strings.load-larger-image;
                clicked => {
                    root.load-image();
                }
            }
        }

        if root.state.kind == 0: Flickable {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := Text {
                width: parent.width;
                text: root.text;
                color: Theme.text;
                font-size: 12px;
                font-family: root.state.mono ? Theme.mono-font : "";
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        if root.state.kind == 1: Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.state.has-picture: Image {
                source: root.state.picture;
                image-fit: contain;
                accessible-role: image;
                accessible-label: root.state.picture-info;
            }
            if !root.state.has-picture: Text {
                text: root.state.note;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        if root.state.kind == 1: Text {
            text: root.state.picture-info;
            color: Theme.text-muted;
            font-size: 11px;
            horizontal-alignment: center;
        }

        if root.state.kind == 2: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                for f in root.state.files: VerticalLayout {
                    spacing: 0px;
                    accessible-role: AccessibleRole.text;
                    accessible-label: f.path;
                    Text {
                        text: f.name;
                        color: Theme.text;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: f.path;
                        color: Theme.text-muted;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }
        }
        if root.state.kind == 2 && root.state.files-more != "": Text {
            text: root.state.files-more;
            color: Theme.text-muted;
            font-size: 11px;
        }

        if root.state.kind == 3: Text {
            vertical-stretch: 1;
            text: root.state.note;
            color: Theme.text-muted;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.state.status != "": Text {
            text: root.state.status;
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// The preview side pane of the popup (Task 702, 03-wireframes section 1): 40 px header (kind
// icon, title, the plain-text and Copy as buttons), the content, then the facts block. `kind`: 0
// text, 1 image, 2 files, 3 masked. A masked clip shows only the note: no content is ever passed
// here. Every text comes from Rust.
export component PreviewPane inherits Rectangle {
    in property <DetailState> state;
    in property <string> text;
    callback load-text();
    callback load-image();
    callback plain();
    callback transform();

    background: Theme.surface;
    accessible-role: groupbox;
    accessible-label: root.state.title;

    VerticalLayout {
        // Header (40 px).
        HorizontalLayout {
            height: 40px;
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: root.state.kind == 1 ? IconName.image
                        : root.state.kind == 2 ? IconName.folder
                        : root.state.kind == 3 ? IconName.eye-off
                        : IconName.file-text;
                    size: 16px;
                    tint: Theme.accent;
                }
            }
            Text {
                text: root.state.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            if root.state.can-plain: VerticalLayout {
                alignment: center;
                IconButton {
                    name: IconName.type;
                    label: Strings.copy-plain;
                    description: Strings.key-shift-enter;
                    shortcut: Strings.key-shift-enter;
                    focusable: false;
                    clicked => {
                        root.plain();
                    }
                }
            }
            if root.state.can-transform: VerticalLayout {
                alignment: center;
                IconButton {
                    name: IconName.wand-sparkles;
                    label: Strings.copy-as;
                    description: Strings.key-ctrl-t;
                    shortcut: Strings.key-ctrl-t;
                    tip-align: TipAlign.end;
                    focusable: false;
                    clicked => {
                        root.transform();
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Content.
        VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 6px;

            if root.state.kind == 0: Flickable {
                vertical-stretch: 1;
                content-height: body.preferred-height;
                body := Text {
                    width: parent.width;
                    text: root.text;
                    color: Theme.text;
                    font-size: 12px;
                    font-family: root.state.mono ? Theme.mono-font : "";
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
            }

            if root.state.kind == 1: Rectangle {
                vertical-stretch: 1;
                clip: true;
                if root.state.has-picture: Image {
                    source: root.state.picture;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: root.state.picture-info;
                }
                if !root.state.has-picture: Text {
                    text: root.state.note;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.state.kind == 2: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for f in root.state.files: VerticalLayout {
                        spacing: 0px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: f.path;
                        Text {
                            text: f.name;
                            color: Theme.text;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: f.path;
                            color: Theme.text-3;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                }
            }
            if root.state.kind == 2 && root.state.files-more != "": Text {
                text: root.state.files-more;
                color: Theme.text-3;
                font-size: 11px;
            }

            if root.state.kind == 3: Text {
                vertical-stretch: 1;
                text: root.state.note;
                color: Theme.text-muted;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.state.status != "": Text {
                text: root.state.status;
                color: Theme.text-3;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.state.kind == 0 && root.state.can-load-text: ActionButton {
                text: Strings.load-full-text;
                clicked => {
                    root.load-text();
                }
            }
            if root.state.kind == 1 && root.state.can-load-image: ActionButton {
                text: Strings.load-larger-image;
                clicked => {
                    root.load-image();
                }
            }
        }

        // Facts (label text-3 11 px, value text 12 px).
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            for f in root.state.facts: HorizontalLayout {
                spacing: 8px;
                accessible-role: AccessibleRole.text;
                accessible-label: f.label + ": " + f.value;
                Text {
                    text: f.label;
                    color: Theme.text-3;
                    font-size: 11px;
                    width: 72px;
                    vertical-alignment: center;
                }
                Text {
                    text: f.value;
                    color: Theme.text;
                    font-size: 12px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    overflow: elide;
                }
            }
        }
    }
}

// ---- The popup layout (Task 701) ---------------------------------------------------------------

// One tab of the filter segment; `id` is the chip id Rust toggles. `show-label` is set for the
// first active tab only, so the segment never outgrows its width budget.
export struct SegTab {
    id: int,
    label: string,
    icon: IconName,
    on: bool,
    show-label: bool,
    divider: bool,
}

// A key cap and its meaning in the status line.
export struct StatusHint {
    key: string,
    label: string,
}

// The filter segment: one Tab stop (the bar), Left/Right move the cursor, Enter and Space toggle
// the tab under it. While the bar has the focus Rust's key map leaves those keys alone
// (`KeyCtx.control_focused`). Every tab is a `checkbox` with its name as label.
export component SegmentBar inherits FocusScope {
    in property <[SegTab]> tabs;
    in property <string> group-label;
    callback toggled(int);
    // Every focus change, so Rust knows a control has the focus.
    callback focus-report(bool);
    property <int> cursor;

    focus-on-click: false;
    height: 30px;
    width: bar.preferred-width + 2px;
    accessible-role: groupbox;
    accessible-label: root.group-label;

    key-pressed(e) => {
        if (e.text == Key.LeftArrow) {
            root.cursor = max(0, root.cursor - 1);
            return accept;
        }
        if (e.text == Key.RightArrow) {
            root.cursor = min(root.tabs.length - 1, root.cursor + 1);
            return accept;
        }
        if (e.text == " " || e.text == Key.Return) {
            if (root.cursor >= 0 && root.cursor < root.tabs.length) {
                root.toggled(root.tabs[root.cursor].id);
            }
            return accept;
        }
        reject
    }
    focus-gained(reason) => {
        root.focus-report(true);
    }
    focus-lost(reason) => {
        root.focus-report(false);
    }

    Rectangle {
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
    }

    bar := HorizontalLayout {
        padding: 1px;
        spacing: 0px;
        for tab[i] in root.tabs: HorizontalLayout {
            spacing: 0px;
            if tab.divider: Rectangle {
                width: 9px;
                Rectangle {
                    x: 4px;
                    y: 7px;
                    width: 1px;
                    height: parent.height - 14px;
                    background: Theme.border-strong;
                }
            }
            Rectangle {
                width: tab.show-label ? 28px + tab-label.preferred-width + 4px : 28px;
                height: 28px;
                border-radius: 6px;
                background: tab.on ? Theme.selected : (tab-touch.has-hover ? Theme.raised : transparent);
                accessible-role: checkbox;
                accessible-checkable: true;
                accessible-checked: tab.on;
                accessible-label: tab.label;
                accessible-action-default => {
                    root.toggled(tab.id);
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: tab.icon;
                            tint: tab.on ? Theme.accent : (tab-touch.has-hover ? Theme.text : Theme.text-2);
                        }
                    }
                    tab-label := Text {
                        visible: tab.show-label;
                        text: tab.show-label ? tab.label : "";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // The keyboard cursor: a 2 px focus ring while the bar has the focus.
                Rectangle {
                    visible: root.has-focus && i == root.cursor;
                    x: -1px;
                    y: -1px;
                    width: parent.width + 2px;
                    height: parent.height + 2px;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: Theme.focus;
                    background: transparent;
                }

                tab-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.cursor = i;
                        root.toggled(tab.id);
                    }
                }

                Tooltip {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: tab.label;
                    active: tab-touch.has-hover || (root.has-focus && i == root.cursor);
                }
            }
        }
    }
}

// The status line (30 px): capture state (a dot and its name) and at most three key hints.
export component StatusLine inherits Rectangle {
    // 1 capturing, 2 paused, 3 private, 0 off.
    in property <int> tone;
    in property <string> text;
    in property <[StatusHint]> hints;
    // The tooltip of the line names the shortcuts sheet and its key (F1): the line has no room
    // for a hint of its own (Task 706, D-084).
    in property <string> tip;
    in property <string> tip-key;

    height: 30px;
    accessible-role: groupbox;
    accessible-label: root.text;

    hover := TouchArea { }

    Tooltip {
        width: parent.width;
        height: parent.height;
        text: root.tip;
        shortcut: root.tip-key;
        align: TipAlign.end;
        active: hover.has-hover;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.tone == 1 ? Theme.success
                    : root.tone == 2 ? Theme.warning
                    : root.tone == 3 ? Theme.text-2
                    : Theme.text-3;
            }
        }
        Text {
            text: root.text;
            color: Theme.text-2;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
        for h in root.hints: HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                KeyCap {
                    text: h.key;
                }
            }
            Text {
                text: h.label;
                color: Theme.text-2;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

// The toast (Task 701): floats above the status line inside the list area and never hides a
// control. `undo` shows the Undo button (ghost, with its key cap). The text is also the
// accessible text of a `text` element.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> undo;
    in property <string> undo-label;
    in property <string> undo-key;
    callback undo-clicked();

    height: 40px;
    border-radius: 8px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-strong;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.undo ? IconName.trash-2 : IconName.info;
                tint: Theme.text-2;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            accessible-role: AccessibleRole.text;
            accessible-label: root.text;
        }
        if root.undo: HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: IconName.undo-2;
                    tint: Theme.text-2;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.undo-label;
                    kind: ButtonKind.ghost;
                    height: 28px;
                    clicked => {
                        root.undo-clicked();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                KeyCap {
                    text: root.undo-key;
                }
            }
        }
    }
}
