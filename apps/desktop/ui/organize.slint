// Organisation widgets of the history window (Task 403): the details strip (favorite, note,
// tags), and one modal dialog that serves every flow (collection name, note, tags, collection
// pickers). Data and every decision come from Rust (`src/organize/`, `src/ui/history_host.rs`);
// this file only lays things out and forwards input. Every string comes from Rust (i18n).
// Task 706: the dialog is drawn with the kit (`DialogScrim`, `Field`, `Button`); its callbacks,
// keys and focus-on-open are the ones it had.

import { ScrollView } from "std-widgets.slint";
import { Theme, Strings } from "theme.slint";
import { Button, ButtonKind } from "kit/button.slint";
import { IconButton } from "kit/icon_button.slint";
import { Icon, IconName } from "kit/icon.slint";
import { Field } from "kit/field.slint";
import { DialogScrim } from "kit/confirm_dialog.slint";

export global OrgStrings {
    in property <string> note-label;
    in property <string> no-note;
    in property <string> edit-note;
    in property <string> tags-label;
    in property <string> collections-label;
    in property <string> no-tags;
    in property <string> edit-tags;
    in property <string> remove-tag;
    in property <string> new-collection;
    in property <string> rename-collection;
    in property <string> delete-collection;
    in property <string> add-to-collection;
    in property <string> remove-from-collection;
    in property <string> org-hints;
    in property <string> collection-keys;
}

// What the dialog shows. `selected` is the highlighted choice of a picker.
export struct OrgDialogState {
    title: string,
    hint: string,
    label: string,
    placeholder: string,
    multiline: bool,
    has-input: bool,
    error: string,
    counter: string,
    counter-bad: bool,
    chips: [string],
    choices: [string],
    selected: int,
    empty-text: string,
    submit-text: string,
    cancel-text: string,
    can-submit: bool,
}

// The modal dialog. It covers the window and takes every click; keys are routed by Rust.
export component OrgDialog inherits DialogScrim {
    in property <OrgDialogState> state;
    in-out property <string> text;
    callback edited(string);
    callback submit();
    callback cancel();
    callback choose(int);
    callback remove-chip(int);

    open: true;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.state.title;

    Rectangle {
        width: min(480px, parent.width - 24px);
        height: min(box.preferred-height + 2px, parent.height - 24px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.canvas;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-strong;

        box := VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: root.state.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                accessible-role: AccessibleRole.text;
            }

            // The chips of the tag editor, one per line.
            if root.state.chips.length > 0: Rectangle {
                height: min(root.state.chips.length * 26px, 130px);
                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for chip[i] in root.state.chips: HorizontalLayout {
                            height: 24px;
                            spacing: 4px;
                            Text {
                                text: chip;
                                color: Theme.accent;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                accessible-role: AccessibleRole.text;
                            }
                            IconButton {
                                name: IconName.x;
                                label: OrgStrings.remove-tag;
                                focusable: false;
                                clicked => {
                                    root.remove-chip(i);
                                }
                            }
                        }
                    }
                }
            }

            // A one-line input: the kit field, with its error written under it.
            if root.state.has-input && !root.state.multiline: Field {
                text <=> root.text;
                placeholder: root.state.placeholder;
                label: root.state.label;
                error: root.state.error;
                edited => {
                    root.edited(self.text);
                }
                init => {
                    self.focus-input();
                }
            }

            if root.state.has-input && root.state.multiline: Rectangle {
                height: 180px;
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: multi.has-focus ? Theme.focus : Theme.border-strong;
                Flickable {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    content-height: max(self.height, multi.preferred-height);
                    multi := TextInput {
                        width: parent.width;
                        text <=> root.text;
                        wrap: word-wrap;
                        single-line: false;
                        color: Theme.text;
                        font-size: 13px;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.bg;
                        accessible-label: root.state.label;
                        accessible-description: root.state.error;
                        edited => {
                            root.edited(self.text);
                        }
                        init => {
                            self.focus();
                        }
                    }
                }
            }

            // A picker: the collections to choose from (kit list rows: `selected` fill, accent bar).
            if !root.state.has-input && root.state.choices.length > 0: Rectangle {
                height: min(root.state.choices.length * 34px, 204px);
                accessible-role: AccessibleRole.list;
                accessible-item-count: root.state.choices.length;
                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for c[i] in root.state.choices: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: i == root.state.selected ? Theme.selected : (row-touch.has-hover ? Theme.raised : transparent);
                            accessible-role: AccessibleRole.list-item;
                            accessible-label: c;
                            accessible-item-selectable: true;
                            accessible-item-selected: i == root.state.selected;
                            accessible-action-default => {
                                root.choose(i);
                            }
                            if i == root.state.selected: Rectangle {
                                x: 0px;
                                y: 7px;
                                width: 3px;
                                height: parent.height - 14px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                            Text {
                                x: 12px;
                                width: parent.width - 20px;
                                text: c;
                                color: i == root.state.selected ? Theme.text : Theme.text-2;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.none;
                            }
                            row-touch := TouchArea {
                                clicked => {
                                    root.choose(i);
                                }
                            }
                        }
                    }
                }
            }
            if !root.state.has-input && root.state.choices.length == 0: Text {
                text: root.state.empty-text;
                color: Theme.text-2;
                font-size: 13px;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }

            // The field writes its own error; the note box and the picker have none, so it is
            // written here for them.
            Text {
                visible: root.state.error != "" && (!root.state.has-input || root.state.multiline);
                height: (root.state.error != "" && (!root.state.has-input || root.state.multiline)) ? self.preferred-height : 0px;
                text: root.state.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
            Text {
                visible: root.state.counter != "";
                height: root.state.counter != "" ? self.preferred-height : 0px;
                text: root.state.counter;
                color: root.state.counter-bad ? Theme.danger : Theme.text-3;
                font-size: 12px;
                horizontal-alignment: right;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: root.state.hint;
                color: Theme.text-3;
                font-size: 12px;
                wrap: word-wrap;
                accessible-role: AccessibleRole.none;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                height: 32px;
                Button {
                    text: root.state.cancel-text;
                    clicked => {
                        root.cancel();
                    }
                }
                Button {
                    kind: ButtonKind.primary;
                    text: root.state.submit-text;
                    visible: root.state.can-submit;
                    clicked => {
                        root.submit();
                    }
                }
            }
        }
    }
}
