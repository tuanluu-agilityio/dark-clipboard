// The popup's 48 px row (Task 701, `02` section 4 and `03` section 1): a 16 px kind icon, one
// preview line and one meta line, badges and the Alt+N number at the end, and three row actions
// (copy, pin, more) while the row is hovered or selected. Everything shown comes from Rust
// (`src/ui/common.rs::popup_clip_row`): a masked clip only ever carries the fixed i18n text, so
// nothing here can show its content. The history window keeps `RowView` until Task 703.

import { Theme } from "theme.slint";
import { Icon, IconName } from "kit/icon.slint";
import { Tooltip } from "kit/tooltip.slint";
import { ClipRow } from "popup.slint";

export global PopupRowMetrics {
    out property <length> height: 48px;
    // The overline (PINNED n / RECENT n) above the first row of a section.
    out property <length> section-height: 22px;
}

// A 28 px icon button of the row, mouse only (the keyboard has keys and the row menu). It reports
// its hover so the row keeps showing its actions while the pointer is on a button.
component RowAction inherits Rectangle {
    in property <IconName> name;
    in property <string> label;
    out property <bool> hover: touch.has-hover;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.pressed ? Theme.canvas : (touch.has-hover ? Theme.raised : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    Icon {
        name: root.name;
        tint: touch.has-hover ? Theme.text : Theme.text-2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Tooltip {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        active: touch.has-hover;
    }
}

export component PopupRow inherits Rectangle {
    in property <ClipRow> data;
    in property <bool> selected;
    in property <int> index;
    // The overline text, used when `data.section` is not 0.
    in property <string> heading;
    // i18n names of the row actions.
    in property <string> copy-label;
    in property <string> pin-label;
    in property <string> more-label;
    callback clicked();
    callback activated();
    // Right click: window coordinates of the pointer.
    callback context(length, length);
    // 0 copy, 1 pin or unpin, 2 more.
    callback action(int);

    property <bool> show-actions: root.selected || touch.has-hover || copy-btn.hover || pin-btn.hover || more-btn.hover;
    property <length> overline: root.data.section > 0 ? PopupRowMetrics.section-height : 0px;

    height: root.overline + PopupRowMetrics.height;
    accessible-role: none;

    if root.data.section > 0: Text {
        x: 12px;
        y: 0px;
        height: PopupRowMetrics.section-height;
        text: root.heading;
        color: Theme.text-3;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: root.heading;
    }

    body := Rectangle {
        y: root.overline;
        height: PopupRowMetrics.height;
        border-radius: 6px;
        background: root.selected ? Theme.selected
            : (touch.has-hover || copy-btn.hover || pin-btn.hover || more-btn.hover ? Theme.surface : transparent);
        accessible-role: list-item;
        accessible-label: root.data.label;
        accessible-description: root.data.description;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected;
        accessible-item-index: root.index;
        accessible-action-default => {
            root.activated();
        }

        // The mouse layer is below the content, so the row actions on top get their own clicks.
        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            double-clicked => {
                root.activated();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
            }
        }

        // Selected row: a 3 px accent bar (a non-colour cue). A pinned row shows its pin icon.
        Rectangle {
            visible: root.selected;
            x: 0px;
            y: 8px;
            width: 3px;
            height: parent.height - 16px;
            border-radius: 1.5px;
            background: Theme.accent;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                Icon {
                    name: root.data.kind-icon;
                    tint: root.selected ? Theme.text : Theme.text-2;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 0px;

                // One preview line: pieces side by side, cut at the right edge.
                Rectangle {
                    height: 18px;
                    min-width: 0px;
                    clip: true;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 0px;
                        for s in root.data.segs: Rectangle {
                            width: piece.preferred-width;
                            height: 18px;
                            piece := Text {
                                text: s.text;
                                color: s.hit ? (root.selected ? Theme.text : Theme.accent)
                                    : (root.data.masked ? Theme.text-3 : Theme.text);
                                font-weight: s.hit ? 600 : 400;
                                font-italic: root.data.masked;
                                font-size: 13px;
                                font-family: root.data.mono ? Theme.mono-font : "";
                                vertical-alignment: center;
                            }
                            // A hit on the selected row: `text` colour plus a 2 px accent underline.
                            Rectangle {
                                visible: s.hit && root.selected;
                                y: parent.height - 2px;
                                height: 2px;
                                width: parent.width;
                                background: Theme.accent;
                            }
                        }
                    }
                }

                Text {
                    height: 16px;
                    text: root.data.meta;
                    color: Theme.text-3;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            // Badges and the Alt+N number; hidden while the row actions show.
            Rectangle {
                width: root.show-actions ? 92px : 64px;
                if !root.show-actions: HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    if root.data.favorite: VerticalLayout {
                        alignment: center;
                        Icon {
                            name: IconName.star;
                            size: 14px;
                            tint: Theme.warning;
                        }
                    }
                    if root.data.pinned: VerticalLayout {
                        alignment: center;
                        Icon {
                            name: IconName.pin;
                            size: 14px;
                            tint: Theme.accent;
                        }
                    }
                    if root.data.masked: VerticalLayout {
                        alignment: center;
                        Icon {
                            name: IconName.eye-off;
                            size: 14px;
                            tint: Theme.warning;
                        }
                    }
                    Text {
                        width: 10px;
                        text: root.data.number;
                        color: Theme.text-3;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }

        // The row actions, over the badges' place.
        Rectangle {
            visible: root.show-actions;
            x: parent.width - 8px - 92px;
            y: (parent.height - 28px) / 2;
            width: 92px;
            height: 28px;
            HorizontalLayout {
                spacing: 4px;
                alignment: end;
                copy-btn := RowAction {
                    name: IconName.copy;
                    label: root.copy-label;
                    clicked => {
                        root.action(0);
                    }
                }
                pin-btn := RowAction {
                    name: root.data.pinned ? IconName.pin-off : IconName.pin;
                    label: root.pin-label;
                    clicked => {
                        root.action(1);
                    }
                }
                more-btn := RowAction {
                    name: IconName.more-horizontal;
                    label: root.more-label;
                    clicked => {
                        root.action(2);
                    }
                }
            }
        }
    }
}
