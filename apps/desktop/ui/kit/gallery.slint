// Every kit component in every state, in one window (Task 700). Nothing creates it at run time:
// it exists so that `slint-build` compiles and type-checks the whole kit (Slint skips components
// that no window instantiates), and so that a later task can open it under `--data-dir` for a
// visual check. Strings are placeholders for that check only and are never shown to users.

import { Theme } from "../theme.slint";
import { Icon, IconName } from "icon.slint";
import { IconButton } from "icon_button.slint";
import { Button, ButtonKind } from "button.slint";
import { KeyCap } from "key_cap.slint";
import { Switch } from "switch.slint";
import { Select } from "select.slint";
import { Field } from "field.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { EmptyState } from "empty_state.slint";
import { Menu, MenuEntry } from "menu.slint";
import { TipAlign, TooltipLayer } from "tooltip.slint";

export component KitGallery inherits Window {
    width: 480px;
    height: 320px;
    background: Theme.canvas;

    in property <[MenuEntry]> entries: [
        { label: "a", icon: IconName.copy, shortcut: "Ctrl+C", danger: false, submenu: false, checked: true },
        { label: "b", icon: IconName.trash-2, shortcut: "", danger: true, submenu: false, checked: false },
        { label: "c", icon: IconName.folder, shortcut: "", danger: false, submenu: true, checked: false },
    ];
    in-out property <int> highlighted;
    callback chosen(int);
    in-out property <bool> flag;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            IconButton {
                name: IconName.settings;
                label: "settings";
                shortcut: "Ctrl+,";
                clicked => {
                    menu.open(self.x, self.y + self.height);
                }
            }
            IconButton {
                name: IconName.trash-2;
                label: "delete";
                danger: true;
                tip-align: TipAlign.start;
            }
            IconButton {
                name: IconName.pin;
                label: "pin";
                active: root.flag;
                focusable: false;
            }
            Icon {
                name: IconName.star;
                tint: Theme.warning;
                size: 14px;
            }
            KeyCap {
                text: "Esc";
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "primary";
                kind: ButtonKind.primary;
            }
            Button {
                text: "secondary";
            }
            Button {
                text: "ghost";
                kind: ButtonKind.ghost;
            }
            Button {
                text: "danger";
                kind: ButtonKind.danger;
            }
            Button {
                text: "disabled";
                enabled: false;
            }
        }
        Switch {
            label: "switch";
            checked <=> root.flag;
        }
        // Settings kit (Task 705).
        HorizontalLayout {
            spacing: 8px;
            Select {
                model: ["one", "two", "three"];
                label: "select";
                // The host answers key presses (src/ui/settings_keys.rs); the gallery handles none.
                key(text, alt, open) => {
                    return 0;
                }
            }
            Field {
                width: 140px;
                placeholder: "field";
                label: "field";
                error: root.flag ? "error" : "";
            }
        }
    }

    // Task 706: what a list shows instead of its rows.
    EmptyState {
        x: 240px;
        y: 150px;
        width: 200px;
        height: 120px;
        icon: IconName.search;
        text: "state";
        hint: "hint";
        danger: root.flag;
    }

    ConfirmDialog {
        open: false;
        title: "title";
        body: "body";
        confirm-text: "ok";
        cancel-text: "cancel";
        danger: root.flag;
    }

    menu := Menu {
        // Anchor at the window origin: `open(x, y)` takes window positions.
        x: 0px;
        y: 0px;
        entries: root.entries;
        highlighted: root.highlighted;
        // The host decides what keys do (Task 701); the gallery only needs the wiring to compile.
        key(text) => {
            return text == "";
        }
        hovered(i) => {
            root.highlighted = i;
        }
        activated(i) => {
            root.chosen(i);
        }
    }

    TooltipLayer { }
}
