// Menu (Task 700): a keyboard-navigable list of actions drawn as an in-window `PopupWindow`
// (never an OS window, so the host window keeps the focus and "close on focus loss" is not
// triggered). The host lists only the actions that are available, so every item can be
// highlighted. Keys (mirrored by `tests/kit.rs`): Up/Down wrap, Home/End jump, Return activates
// the highlighted item, Escape closes. Labels and key caps come from i18n.
//
// Use: `menu.open(x, y)` with a position in the host window. Slint moves a `PopupWindow` that
// would cross the window edge back inside it (checked in the Task 700 investigation, D-079), so
// the host needs no edge logic. While the menu is open Slint sends every key to it, so the
// menu's own `FocusScope` takes the focus when it opens (`init`).

import { Theme } from "../theme.slint";
import { Icon, IconName } from "icon.slint";
import { KeyCap } from "key_cap.slint";

export struct MenuEntry {
    label: string,
    icon: IconName,
    // Key cap text such as "Ctrl+D"; empty for none.
    shortcut: string,
    // Destructive entries are drawn in `danger`.
    danger: bool,
}

export component MenuItem inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> highlighted;
    callback hovered();
    callback activated();

    height: 28px;
    border-radius: 6px;
    background: root.highlighted ? Theme.selected : transparent;
    accessible-role: button;
    accessible-label: root.entry.label;
    accessible-action-default => {
        root.activated();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            name: root.entry.icon;
            size: 16px;
            tint: root.entry.danger ? Theme.danger : (root.highlighted ? Theme.text : Theme.text-2);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.entry.label;
            color: root.entry.danger ? Theme.danger : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.entry.shortcut != "": KeyCap {
            text: root.entry.shortcut;
            y: (parent.height - self.height) / 2;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        moved => {
            root.hovered();
        }
        clicked => {
            root.activated();
        }
    }
}

export component Menu inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <length> menu-width: 220px;
    in-out property <int> highlighted;
    // Index of the entry the user chose.
    callback activated(int);
    callback dismissed();

    property <length> menu-height: root.entries.length * 28px + 8px;
    property <length> px;
    property <length> py;

    // Zero-size anchor; the menu is positioned by `open`.
    width: 0px;
    height: 0px;
    accessible-role: none;

    // Opens the menu with its top-left corner at (x, y) of the anchor's parent coordinates.
    public function open(x: length, y: length) {
        root.px = x;
        root.py = y;
        root.highlighted = 0;
        pop.show();
    }

    public function close() {
        pop.close();
    }

    pop := PopupWindow {
        x: root.px;
        y: root.py;
        width: root.menu-width;
        height: root.menu-height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;

            scope := FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(e) => {
                    // An empty menu only closes (same as `menu_key` in tests/kit.rs).
                    if (root.entries.length == 0) {
                        if (e.text == Key.Escape) {
                            pop.close();
                            root.dismissed();
                            return accept;
                        }
                        return reject;
                    }
                    if (e.text == Key.DownArrow) {
                        root.highlighted = Math.mod(root.highlighted + 1, root.entries.length);
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        root.highlighted = Math.mod(root.highlighted + root.entries.length - 1, root.entries.length);
                        return accept;
                    }
                    if (e.text == Key.Home) {
                        root.highlighted = 0;
                        return accept;
                    }
                    if (e.text == Key.End) {
                        root.highlighted = root.entries.length - 1;
                        return accept;
                    }
                    if (e.text == Key.Return) {
                        pop.close();
                        root.activated(root.highlighted);
                        return accept;
                    }
                    if (e.text == Key.Escape) {
                        pop.close();
                        root.dismissed();
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    padding: 4px;
                    for entry[i] in root.entries: MenuItem {
                        entry: entry;
                        highlighted: root.highlighted == i;
                        hovered => {
                            root.highlighted = i;
                        }
                        activated => {
                            pop.close();
                            root.activated(i);
                        }
                    }
                }
            }
        }
    }
}
