// Menu (Task 700): a keyboard-navigable list of actions drawn as an in-window `PopupWindow`
// (never an OS window, so the host window keeps the focus and "close on focus loss" is not
// triggered). The host lists only the actions that are available, so every item can be
// highlighted. The menu does not decide what a key does (F-31, Task 701): its `FocusScope` forwards
// every key text through `key(string) -> bool`, and the host (`src/popup/menu.rs`) owns the
// state, moves the highlight through the `highlighted` property and closes the menu with
// `close()`. Labels and key caps come from i18n.
//
// Use: `menu.open(x, y)` with a position in the host window. Slint moves a `PopupWindow` that
// would cross the window edge back inside it (checked in the Task 700 investigation, D-079), so
// the host needs no edge logic. While the menu is open Slint sends every key to it, so the
// menu's own `FocusScope` takes the focus when it opens (`init`).

import { Theme } from "../theme.slint";
import { Icon, IconName } from "icon.slint";
import { KeyCap } from "key_cap.slint";

export struct MenuEntry {
    label: string,
    icon: IconName,
    // Key cap text such as "Ctrl+D"; empty for none.
    shortcut: string,
    // Destructive entries are drawn in `danger`.
    danger: bool,
    // Opens a second-level list: drawn with a chevron, and a click leaves the menu open.
    submenu: bool,
    // A filter that is on: drawn with a check.
    checked: bool,
}

export component MenuItem inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> highlighted;
    callback hovered();
    callback activated();

    height: 28px;
    border-radius: 6px;
    background: root.highlighted ? Theme.selected : transparent;
    accessible-role: button;
    accessible-label: root.entry.label;
    accessible-checkable: root.entry.checked;
    accessible-checked: root.entry.checked;
    accessible-action-default => {
        root.activated();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            name: root.entry.icon;
            size: 16px;
            tint: root.entry.danger ? Theme.danger : (root.highlighted ? Theme.text : Theme.text-2);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.entry.label;
            color: root.entry.danger ? Theme.danger : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.entry.shortcut != "": KeyCap {
            text: root.entry.shortcut;
            y: (parent.height - self.height) / 2;
        }
        if root.entry.checked: Icon {
            name: IconName.check;
            size: 16px;
            tint: Theme.accent;
            y: (parent.height - self.height) / 2;
        }
        if root.entry.submenu: Icon {
            name: IconName.chevron-right;
            size: 16px;
            tint: Theme.text-2;
            y: (parent.height - self.height) / 2;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        moved => {
            root.hovered();
        }
        clicked => {
            root.activated();
        }
    }
}

export component Menu inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <length> menu-width: 220px;
    // Driven by the host (hover and keys both go through Rust).
    in property <int> highlighted;
    // Every key text the open menu receives; true when the host handled it.
    callback key(string) -> bool;
    // The pointer moved over an entry.
    callback hovered(int);
    // Index of the entry the user clicked. The menu closes first, except for a `submenu` entry.
    callback activated(int);
    callback dismissed();

    property <length> menu-height: root.entries.length * 28px + 8px;
    property <length> px;
    property <length> py;

    // Zero-size anchor; the menu is positioned by `open`.
    width: 0px;
    height: 0px;
    accessible-role: none;

    // Opens the menu with its top-left corner at (x, y) of the anchor's parent coordinates.
    public function open(x: length, y: length) {
        root.px = x;
        root.py = y;
        pop.show();
    }

    public function close() {
        pop.close();
    }

    pop := PopupWindow {
        x: root.px;
        y: root.py;
        width: root.menu-width;
        height: root.menu-height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;

            scope := FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(e) => {
                    if (root.key(e.text)) {
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    padding: 4px;
                    for entry[i] in root.entries: MenuItem {
                        entry: entry;
                        highlighted: root.highlighted == i;
                        hovered => {
                            root.hovered(i);
                        }
                        activated => {
                            if (!entry.submenu) {
                                pop.close();
                            }
                            root.activated(i);
                        }
                    }
                }
            }
        }
    }
}
