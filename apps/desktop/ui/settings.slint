// The settings window (Task 207, redesigned in Task 705): General, Capture and Privacy, History
// and Storage, Data and Transfer, Translate (Task 606), About. Every value and every
// decision comes from Rust (`src/ui/settings_host.rs`, with the pure rules in `src/prefs`);
// this file lays things out and forwards input. Every string comes from the `SText` global
// (i18n), never from here. Dark only (D-037).
//
// The OS and Darkshot privacy markers card is only drawn: there is no control for it in this
// file, and none can be added without changing the Rust side (GC-07). Each setting carries a
// `// section:N id` marker that `tests/settings_sections.rs` checks against `SETTING_SECTIONS`.

import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconName } from "kit/icon.slint";
import { Button, ButtonKind } from "kit/button.slint";
import { Switch } from "kit/switch.slint";
import { Select } from "kit/select.slint";
import { Field } from "kit/field.slint";
import { ConfirmDialog, DialogScrim } from "kit/confirm_dialog.slint";
import { NavItem, Card, SettingRow, InfoRow, ModeCard, SaveButton, ProtectedRow, TrText, TrEnableCard, TrHowCard, TrKeyCard, TrNeverCard, TrConsentDialog } from "settings_parts.slint";

export { TrText }

export struct AppRow {
    name: string,
    id: string,
    builtin: bool,
    platform: string,
}

export struct KindItem {
    label: string,
    on: bool,
}

export global SText {
    in property <string> title;
    in property <string> general;
    in property <string> privacy;
    in property <string> history;
    in property <string> about;
    // Non-empty while the settings file is read-only (D-028).
    in property <string> banner;
    in property <string> save;
    in property <string> revert;
    in property <string> cancel;
    in property <string> close;
    in property <string> loading;
    in property <string> notices;
    in property <string> limits-confirm;
    // General
    in property <string> shortcut-label;
    in property <string> shortcut-hint;
    in property <string> shortcut-warning;
    in property <string> lang-label;
    in property <string> lang-en;
    in property <string> lang-vi;
    in property <string> login;
    in property <string> login-note;
    in property <string> login-drift;
    in property <string> pos-label;
    in property <string> pos-cursor;
    in property <string> pos-center;
    in property <string> close-focus;
    in property <string> enter-pastes;
    // Privacy
    in property <string> capture-label;
    in property <string> mode-normal;
    in property <string> mode-private;
    in property <string> mode-paused;
    in property <string> mode-current;
    in property <string> capture-off-text;
    in property <string> start-capturing;
    in property <string> markers-label;
    in property <string> markers-note;
    in property <string> sensitive-label;
    in property <string> sens-drop;
    in property <string> sens-masked;
    in property <string> sens-store;
    in property <string> sens-warn;
    in property <string> kinds-label;
    in property <string> excluded-label;
    in property <string> excluded-note;
    in property <string> builtin-badge;
    in property <string> remove;
    in property <string> add;
    in property <string> app-placeholder;
    in property <string> pick-running;
    in property <string> pick-none;
    in property <string> pick-note;
    in property <string> confirm-builtin;
    // History
    in property <string> max-items-label;
    in property <string> max-age-label;
    in property <string> max-storage-label;
    in property <string> retention-note;
    in property <string> stats-label;
    in property <string> skipped-label;
    in property <string> clear;
    in property <string> clear-confirm;
    in property <string> keep-pinned;
    in property <string> clear-do;
    in property <string> cleanup-heading;
    in property <string> older-label;
    in property <string> older-do;
    in property <string> orphans-do;
    in property <string> compact-do;
    // About
    in property <string> version;
    in property <string> caps-label;
    in property <string> licences-label;
    in property <string> licence-text;
    in property <string> third-party;
    in property <string> folder-label;
    in property <string> open-folder;
    in property <string> show-welcome;
    // Backup and transfer (Task 405)
    in property <string> transfer-heading;
    in property <string> transfer-note;
    in property <string> backup-do;
    in property <string> restore-do;
    in property <string> import-do;
    in property <string> restore-yes;
    // Updates (Task 412)
    in property <string> updates-heading;
    in property <string> update-check;
    in property <string> update-auto;
    in property <string> update-note;
    in property <string> update-open;
    // Redesign (Task 705): nav names, section descriptions, card titles, capture-mode cards,
    // the Always protected card, the save bar and the dialog titles.
    in property <string> nav-capture;
    in property <string> nav-storage;
    in property <string> nav-data;
    in property <string> desc-general;
    in property <string> desc-capture;
    in property <string> desc-storage;
    in property <string> desc-data;
    in property <string> desc-about;
    in property <string> card-popup;
    in property <string> card-app;
    in property <string> card-sensitive;
    in property <string> card-limits;
    in property <string> enter-pastes-note;
    in property <string> card-recording;
    in property <string> card-private;
    in property <string> card-paused;
    in property <string> card-recording-line;
    in property <string> card-private-line;
    in property <string> card-paused-line;
    in property <string> always-protected;
    in property <string> protected-os;
    in property <string> protected-darkshot;
    in property <string> unsaved;
    in property <string> key-ctrl-s;
    in property <string> dlg-remove;
    in property <string> dlg-limits;
    in property <string> dlg-clear;
    in property <string> dlg-restore;
    in property <string> clear-row;
}

// A one-line explanation under a heading.
component Note inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.text-3;
    in property <length> pad-top;
    in property <length> pad-bottom;

    height: txt.preferred-height + root.pad-top + root.pad-bottom;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    txt := Text {
        y: root.pad-top;
        width: parent.width;
        text: root.text;
        color: root.tone;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component SettingsWindow inherits Window {
    icon: Theme.window-icon;
    title: SText.title;
    background: Theme.bg;
    min-width: 680px;
    min-height: 480px;
    preferred-width: 860px;
    preferred-height: 640px;
    default-font-size: 13px;

    // 0 General, 1 Capture and Privacy, 2 History and Storage, 3 Data and Transfer, 4 Translate,
    // 5 About.
    in-out property <int> section: 0;
    in property <bool> can-save: true;
    // Something was changed since the last save, revert or open: the save bar shows (Rust owns it).
    in property <bool> dirty;
    // Capture is switched off (before the first-run Start): the Privacy section says so.
    in property <bool> capture-off;
    // False when start at login cannot be changed from this process (custom data folder).
    in property <bool> login-enabled: true;
    // The form values (read by Rust on Save).
    in-out property <string> shortcut;
    in-out property <int> lang-index;
    in-out property <bool> launch-at-login;
    in-out property <int> position-index;
    in-out property <bool> close-on-focus-loss;
    in-out property <bool> enter-pastes;
    in-out property <int> sensitive-index;
    in-out property <[KindItem]> kinds;
    in-out property <string> max-items;
    in-out property <string> max-age;
    in-out property <string> max-storage;
    in-out property <string> new-app;
    in property <[AppRow]> apps;
    // Per-field messages (empty: fine) and the result of the last save.
    in property <string> err-shortcut;
    in property <string> err-items;
    in property <string> err-age;
    in property <string> err-storage;
    in property <string> err-kinds;
    in property <string> err-app;
    in property <string> status;
    in property <bool> status-error;
    // The capture mode cards: 0 capturing, 1 private, 2 paused.
    in property <int> mode;
    // Non-empty while the built-in exclusion removal asks for confirmation.
    in property <string> confirm-remove-text;
    in property <bool> picker-open;
    in property <bool> picker-loading;
    in property <[string]> picker;
    in property <bool> clear-open;
    in property <bool> limits-open;
    in-out property <bool> clear-keep-pinned: true;
    // The question of the clear dialog (it names the count for the switch state).
    in property <string> clear-question;
    in property <bool> cleanup-open;
    // A backup, restore or import is running, or its file dialog is open.
    in property <bool> transfer-busy;
    in property <bool> restore-open;
    in property <string> restore-question;
    in property <string> cleanup-question;
    in-out property <string> older-days: "30";
    // Multi-line texts.
    in property <string> stats-text;
    in property <string> skip-text;
    in property <string> caps-text;
    in property <string> version-text;
    // Opt-in update check (Task 412): the text is the result; the open button shows only when
    // a newer release was found.
    in property <string> update-status;
    in property <bool> update-busy;
    in property <bool> update-found;
    in-out property <bool> auto-update;
    in property <bool> auto-update-enabled: true;
    in property <string> data-path;
    // Settings > Translate (Task 606). `tr-available` is false off Windows.
    in property <bool> tr-available: true;
    in-out property <bool> tr-enabled;
    in-out property <string> tr-shortcut;
    in property <string> err-tr-shortcut;
    in-out property <int> tr-direction-index;
    in-out property <int> tr-model-index;
    in property <bool> tr-key-editing: true;
    in property <string> tr-key-status;
    in property <string> tr-key-error;
    in-out property <string> tr-key-input;
    in property <string> tr-test-text;
    in property <bool> tr-test-busy;
    in property <bool> tr-consent-open;

    callback save();
    callback revert();
    callback edited();
    callback set-mode(int);
    callback start-capturing();
    callback add-app(string);
    callback remove-app(int);
    callback confirm-remove();
    callback cancel-remove();
    callback open-picker();
    callback close-picker();
    callback pick-app(int);
    callback limits-confirm();
    callback limits-cancel();
    callback clear-ask();
    callback clear-confirm();
    callback clear-cancel();
    callback clear-toggled(bool);
    callback older-ask(string);
    callback orphans-ask();
    callback compact-ask();
    callback cleanup-confirm();
    callback cleanup-cancel();
    callback backup-ask();
    callback restore-ask();
    callback import-ask();
    callback restore-confirm();
    callback restore-cancel();
    callback open-folder();
    callback show-welcome();
    callback check-updates();
    callback auto-update-toggled(bool);
    callback open-release();
    callback escape();
    callback tr-toggled(bool);
    callback tr-consent-confirm();
    callback tr-consent-cancel();
    callback tr-save-key(string);
    callback tr-replace-key();
    callback tr-remove-key();
    callback tr-test();
    // Every key before the focused element: text, Ctrl, Shift, Alt, Meta, a nav item has the
    // focus. True when the host handled it (Task 705: the meaning of a key is decided in Rust).
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    // What a key does to a `Select`: text, Alt, list open -> code (see `kit/select.slint`).
    callback select-key(string, bool, bool) -> int;

    // A nav item has the keyboard focus (Up and Down then move between sections).
    property <bool> nav-focus: nav0.has-focus || nav1.has-focus || nav2.has-focus || nav3.has-focus || nav4.has-focus || nav5.has-focus;
    // One of the questions or the picker is open.
    property <bool> layer-open: root.confirm-remove-text != "" || root.limits-open || root.clear-open || root.cleanup-open || root.restore-open || root.picker-open || root.tr-consent-open;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // The control that opened the layer (0: none or not known, 1 picker, 2 orphans, 3 compact,
    // 4 clear, 5 restore, 6 save, 100 + i the remove button of exclusion row i), and the one that
    // gets the focus back when the layer closes (each of them has a `want` property that
    // focuses it when `return-to` names it; Slint cannot name the element that had the focus).
    property <int> opener;
    property <int> return-to;

    // Opening a layer clears the last return (so the same opener works twice); closing it puts
    // the focus on the window first, then on the opener (D-082, Task 707).
    changed layer-open => {
        if (root.layer-open) {
            root.return-to = 0;
        } else {
            main.focus();
            root.return-to = root.opener;
            root.opener = 0;
        }
    }

    // The section changed by the keys (Ctrl+digit, Up, Down): while a nav item has the focus the
    // ring follows the selection.
    changed section => {
        if (root.nav-focus) {
            if (root.section == 0) {
                nav0.focus();
            } else if (root.section == 1) {
                nav1.focus();
            } else if (root.section == 2) {
                nav2.focus();
            } else if (root.section == 3) {
                nav3.focus();
            } else if (root.section == 4) {
                nav4.focus();
            } else {
                nav5.focus();
            }
        }
    }

    main := FocusScope {
        init => {
            self.focus();
        }
        capture-key-pressed(e) => {
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, root.nav-focus)) {
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // Left: the sections.
            Rectangle {
                width: 220px;
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;
                    accessible-role: tab-list;
                    nav0 := NavItem {
                        icon: IconName.sliders-horizontal;
                        text: SText.general;
                        active: root.section == 0;
                        clicked => {
                            root.section = 0;
                            self.focus();
                        }
                    }
                    nav1 := NavItem {
                        icon: IconName.shield-check;
                        text: SText.nav-capture;
                        active: root.section == 1;
                        clicked => {
                            root.section = 1;
                            self.focus();
                        }
                    }
                    nav2 := NavItem {
                        icon: IconName.database;
                        text: SText.nav-storage;
                        active: root.section == 2;
                        clicked => {
                            root.section = 2;
                            self.focus();
                        }
                    }
                    nav3 := NavItem {
                        icon: IconName.arrow-left-right;
                        text: SText.nav-data;
                        active: root.section == 3;
                        clicked => {
                            root.section = 3;
                            self.focus();
                        }
                    }
                    nav4 := NavItem {
                        icon: IconName.type;
                        text: TrText.section;
                        active: root.section == 4;
                        clicked => {
                            root.section = 4;
                            self.focus();
                        }
                    }
                    nav5 := NavItem {
                        icon: IconName.info;
                        text: SText.about;
                        active: root.section == 5;
                        clicked => {
                            root.section = 5;
                            self.focus();
                        }
                    }
                }
            }

            // Right: the banner, the section, the status line and the save bar.
            VerticalLayout {
                horizontal-stretch: 1;

                if SText.banner != "": Rectangle {
                    background: Theme.warning.with-alpha(0.18);
                    border-color: Theme.warning;
                    border-width: 1px;
                    height: banner-text.preferred-height + 20px;
                    accessible-role: text;
                    accessible-label: SText.banner;
                    banner-text := Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        text: SText.banner;
                        color: Theme.warning;
                        wrap: word-wrap;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        alignment: start;

                        Text {
                            text: [SText.general, SText.nav-capture, SText.nav-storage, SText.nav-data, TrText.section, SText.about][root.section];
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            wrap: word-wrap;
                            accessible-role: text;
                        }
                        Text {
                            text: [SText.desc-general, SText.desc-capture, SText.desc-storage, SText.desc-data, TrText.section-desc, SText.desc-about][root.section];
                            color: Theme.text-2;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        // ---------------------------------------------------- General
                        if root.section == 0: VerticalLayout {
                            spacing: 16px;
                            Card {
                                title: SText.card-popup;
                                // section:0 shortcut
                                SettingRow {
                                    first: true;
                                    label: SText.shortcut-label;
                                    error: root.err-shortcut != "" ? (SText.shortcut-warning != "" ? root.err-shortcut + "\n" + SText.shortcut-warning : root.err-shortcut) : SText.shortcut-warning;
                                    Field {
                                        width: 220px;
                                        text <=> root.shortcut;
                                        placeholder: SText.shortcut-hint;
                                        label: SText.shortcut-label;
                                        error: root.err-shortcut;
                                        inline-error: false;
                                        edited => {
                                            root.edited();
                                        }
                                    }
                                }
                                // section:0 popup-position
                                SettingRow {
                                    label: SText.pos-label;
                                    Select {
                                        model: [SText.pos-cursor, SText.pos-center];
                                        current-index <=> root.position-index;
                                        label: SText.pos-label;
                                        selected(v) => {
                                            root.edited();
                                        }
                                        key(t, a, o) => {
                                            return root.select-key(t, a, o);
                                        }
                                    }
                                }
                                // section:0 close-on-focus-loss
                                SettingRow {
                                    label: SText.close-focus;
                                    Switch {
                                        label: SText.close-focus;
                                        checked <=> root.close-on-focus-loss;
                                        toggled(v) => {
                                            root.edited();
                                        }
                                    }
                                }
                                // section:0 enter-pastes
                                SettingRow {
                                    label: SText.enter-pastes;
                                    description: SText.enter-pastes-note;
                                    Switch {
                                        label: SText.enter-pastes;
                                        description: SText.enter-pastes-note;
                                        checked <=> root.enter-pastes;
                                        toggled(v) => {
                                            root.edited();
                                        }
                                    }
                                }
                            }
                            Card {
                                title: SText.card-app;
                                // section:0 language
                                SettingRow {
                                    first: true;
                                    label: SText.lang-label;
                                    Select {
                                        model: [SText.lang-en, SText.lang-vi];
                                        current-index <=> root.lang-index;
                                        label: SText.lang-label;
                                        selected(v) => {
                                            root.edited();
                                        }
                                        key(t, a, o) => {
                                            return root.select-key(t, a, o);
                                        }
                                    }
                                }
                                // section:0 start-at-login
                                SettingRow {
                                    label: SText.login;
                                    description: SText.login-drift != "" ? (SText.login-note != "" ? SText.login-note + "\n" + SText.login-drift : SText.login-drift) : SText.login-note;
                                    Switch {
                                        label: SText.login;
                                        enabled: root.login-enabled;
                                        checked <=> root.launch-at-login;
                                        toggled(v) => {
                                            root.edited();
                                        }
                                    }
                                }
                                // section:0 show-welcome
                                SettingRow {
                                    label: SText.show-welcome;
                                    Button {
                                        text: SText.show-welcome;
                                        clicked => {
                                            root.show-welcome();
                                        }
                                    }
                                }
                            }
                        }

                        // ---------------------------------------------------- Capture and Privacy
                        if root.section == 1: VerticalLayout {
                            spacing: 16px;
                            // section:1 capture-mode
                            VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: SText.capture-label;
                                    color: Theme.text-2;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ModeCard {
                                        icon: IconName.play;
                                        title: SText.card-recording;
                                        line: SText.card-recording-line;
                                        label: SText.mode-normal;
                                        selected: root.mode == 0;
                                        clicked => {
                                            root.set-mode(0);
                                        }
                                    }
                                    ModeCard {
                                        icon: IconName.eye-off;
                                        title: SText.card-private;
                                        line: SText.card-private-line;
                                        label: SText.mode-private;
                                        selected: root.mode == 1;
                                        clicked => {
                                            root.set-mode(1);
                                        }
                                    }
                                    ModeCard {
                                        icon: IconName.pause;
                                        title: SText.card-paused;
                                        line: SText.card-paused-line;
                                        label: SText.mode-paused;
                                        selected: root.mode == 2;
                                        clicked => {
                                            root.set-mode(2);
                                        }
                                    }
                                }
                                Note {
                                    text: SText.mode-current;
                                    tone: Theme.text-2;
                                }
                            }
                            if root.capture-off: Rectangle {
                                background: Theme.warning.with-alpha(0.18);
                                border-color: Theme.warning;
                                border-width: 1px;
                                border-radius: 6px;
                                height: off-col.preferred-height + 20px;
                                off-col := VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: SText.capture-off-text;
                                        color: Theme.warning;
                                        wrap: word-wrap;
                                        accessible-role: text;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            text: SText.start-capturing;
                                            kind: ButtonKind.primary;
                                            clicked => {
                                                root.start-capturing();
                                            }
                                        }
                                    }
                                }
                            }

                            // section:1 always-protected
                            // always-protected:begin
                            Card {
                                title: SText.always-protected;
                                ProtectedRow {
                                    text: SText.protected-os;
                                }
                                ProtectedRow {
                                    text: SText.protected-darkshot;
                                }
                                Note {
                                    text: SText.markers-note;
                                    accessible-label: SText.markers-label + ". " + SText.markers-note;
                                }
                            }
                            // always-protected:end

                            Card {
                                title: SText.card-sensitive;
                                // section:1 sensitive-content
                                SettingRow {
                                    first: true;
                                    label: SText.sensitive-label;
                                    error: root.sensitive-index == 2 ? SText.sens-warn : "";
                                    Select {
                                        model: [SText.sens-drop, SText.sens-masked, SText.sens-store];
                                        current-index <=> root.sensitive-index;
                                        label: SText.sensitive-label;
                                        selected(v) => {
                                            root.edited();
                                        }
                                        key(t, a, o) => {
                                            return root.select-key(t, a, o);
                                        }
                                    }
                                }
                            }

                            // section:1 excluded-apps
                            Card {
                                title: SText.excluded-label;
                                Note {
                                    text: SText.excluded-note;
                                    pad-bottom: 6px;
                                }
                                for a[i] in root.apps: Rectangle {
                                    height: 40px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: (a.name != "" ? a.name + " (" + a.id + ")" : a.id) + "  -  " + a.platform;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if a.builtin: Text {
                                            text: SText.builtin-badge;
                                            color: Theme.text-2;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Button {
                                            text: SText.remove;
                                            kind: ButtonKind.ghost;
                                            y: (parent.height - self.height) / 2;
                                            property <bool> want: root.return-to == 100 + i;
                                            changed want => {
                                                if (self.want) {
                                                    self.focus();
                                                }
                                            }
                                            clicked => {
                                                root.opener = 100 + i;
                                                root.remove-app(i);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    Field {
                                        text <=> root.new-app;
                                        placeholder: SText.app-placeholder;
                                        label: SText.app-placeholder;
                                        error: root.err-app;
                                        inline-error: false;
                                        horizontal-stretch: 1;
                                        accepted => {
                                            root.add-app(root.new-app);
                                        }
                                    }
                                    Button {
                                        text: SText.add;
                                        clicked => {
                                            root.add-app(root.new-app);
                                        }
                                    }
                                    Button {
                                        text: SText.pick-running;
                                        property <bool> want: root.return-to == 1;
                                        changed want => {
                                            if (self.want) {
                                                self.focus();
                                            }
                                        }
                                        clicked => {
                                            root.opener = 1;
                                            root.open-picker();
                                        }
                                    }
                                }
                                if root.err-app != "": Text {
                                    text: root.err-app;
                                    color: Theme.danger;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            Card {
                                title: SText.kinds-label;
                                // section:1 kinds
                                for k[i] in root.kinds: SettingRow {
                                    first: i == 0;
                                    label: k.label;
                                    Switch {
                                        label: k.label;
                                        checked: k.on;
                                        toggled(v) => {
                                            root.kinds[i] = { label: k.label, on: v };
                                            root.edited();
                                        }
                                    }
                                }
                                if root.err-kinds != "": Text {
                                    text: root.err-kinds;
                                    color: Theme.danger;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                // section:1 skip-summary
                                InfoRow {
                                    label: SText.skipped-label;
                                    value: root.skip-text;
                                }
                            }
                        }

                        // ---------------------------------------------------- History and Storage
                        if root.section == 2: VerticalLayout {
                            spacing: 16px;
                            Card {
                                title: SText.card-limits;
                                // section:2 max-items
                                SettingRow {
                                    first: true;
                                    label: SText.max-items-label;
                                    error: root.err-items;
                                    Field {
                                        width: 120px;
                                        text <=> root.max-items;
                                        input-type: InputType.number;
                                        label: SText.max-items-label;
                                        error: root.err-items;
                                        inline-error: false;
                                        edited => {
                                            root.edited();
                                        }
                                    }
                                }
                                // section:2 max-age
                                SettingRow {
                                    label: SText.max-age-label;
                                    error: root.err-age;
                                    Field {
                                        width: 120px;
                                        text <=> root.max-age;
                                        input-type: InputType.number;
                                        label: SText.max-age-label;
                                        error: root.err-age;
                                        inline-error: false;
                                        edited => {
                                            root.edited();
                                        }
                                    }
                                }
                                // section:2 max-storage
                                SettingRow {
                                    label: SText.max-storage-label;
                                    error: root.err-storage;
                                    Field {
                                        width: 120px;
                                        text <=> root.max-storage;
                                        input-type: InputType.number;
                                        label: SText.max-storage-label;
                                        error: root.err-storage;
                                        inline-error: false;
                                        edited => {
                                            root.edited();
                                        }
                                    }
                                }
                                Note {
                                    text: SText.retention-note;
                                    pad-top: 8px;
                                    pad-bottom: 4px;
                                }
                            }

                            Card {
                                title: SText.stats-label;
                                // section:2 storage-stats
                                InfoRow {
                                    first: true;
                                    label: SText.stats-label;
                                    value: root.stats-text;
                                }
                            }

                            Card {
                                title: SText.cleanup-heading;
                                // section:2 cleanup
                                SettingRow {
                                    first: true;
                                    label: SText.older-label;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field {
                                            width: 80px;
                                            text <=> root.older-days;
                                            input-type: InputType.number;
                                            label: SText.older-label;
                                        }
                                        Button {
                                            text: SText.older-do;
                                            clicked => {
                                                root.older-ask(root.older-days);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    padding-top: 10px;
                                    padding-bottom: 6px;
                                    Button {
                                        text: SText.orphans-do;
                                        property <bool> want: root.return-to == 2;
                                        changed want => {
                                            if (self.want) {
                                                self.focus();
                                            }
                                        }
                                        clicked => {
                                            root.opener = 2;
                                            root.orphans-ask();
                                        }
                                    }
                                    Button {
                                        text: SText.compact-do;
                                        property <bool> want: root.return-to == 3;
                                        changed want => {
                                            if (self.want) {
                                                self.focus();
                                            }
                                        }
                                        clicked => {
                                            root.opener = 3;
                                            root.compact-ask();
                                        }
                                    }
                                }
                            }

                            Card {
                                title: SText.history;
                                // section:2 clear-history
                                SettingRow {
                                    first: true;
                                    label: SText.clear-row;
                                    Button {
                                        text: SText.clear;
                                        kind: ButtonKind.danger;
                                        property <bool> want: root.return-to == 4;
                                        changed want => {
                                            if (self.want) {
                                                self.focus();
                                            }
                                        }
                                        clicked => {
                                            root.opener = 4;
                                            root.clear-ask();
                                        }
                                    }
                                }
                            }
                        }

                        // ---------------------------------------------------- Data and Transfer
                        if root.section == 3: VerticalLayout {
                            spacing: 16px;
                            Card {
                                title: SText.transfer-heading;
                                Note {
                                    text: SText.transfer-note;
                                    pad-bottom: 8px;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    padding-bottom: 8px;
                                    // section:3 backup
                                    Button {
                                        text: SText.backup-do;
                                        enabled: !root.transfer-busy;
                                        clicked => {
                                            root.backup-ask();
                                        }
                                    }
                                    // section:3 restore
                                    Button {
                                        text: SText.restore-do;
                                        enabled: !root.transfer-busy;
                                        property <bool> want: root.return-to == 5;
                                        changed want => {
                                            if (self.want) {
                                                self.focus();
                                            }
                                        }
                                        clicked => {
                                            root.opener = 5;
                                            root.restore-ask();
                                        }
                                    }
                                    // section:3 import
                                    Button {
                                        text: SText.import-do;
                                        enabled: !root.transfer-busy;
                                        clicked => {
                                            root.import-ask();
                                        }
                                    }
                                }
                            }
                            Card {
                                title: SText.folder-label;
                                // section:3 data-folder
                                InfoRow {
                                    first: true;
                                    label: SText.folder-label;
                                    value: root.data-path;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    padding-bottom: 8px;
                                    Button {
                                        text: SText.open-folder;
                                        clicked => {
                                            root.open-folder();
                                        }
                                    }
                                }
                            }
                        }

                        // ---------------------------------------------------- Translate (Task 606)
                        if root.section == 4: VerticalLayout {
                            spacing: 16px;
                            // section:4 translate-enable
                            TrEnableCard {
                                available: root.tr-available;
                                checked <=> root.tr-enabled;
                                toggled(v) => {
                                    root.tr-toggled(v);
                                }
                            }
                            // The shortcut, direction and model rows.
                            // section:4 translate-shortcut
                            // section:4 translate-direction
                            // section:4 translate-model
                            TrHowCard {
                                on: root.tr-available && root.tr-enabled;
                                shortcut <=> root.tr-shortcut;
                                error: root.err-tr-shortcut;
                                direction-index <=> root.tr-direction-index;
                                model-index <=> root.tr-model-index;
                                edited => {
                                    root.edited();
                                }
                                select-key(t, a, o) => {
                                    return root.select-key(t, a, o);
                                }
                            }
                            // The key row and the Test row.
                            // section:4 translate-key
                            // section:4 translate-test
                            TrKeyCard {
                                on: root.tr-available && root.tr-enabled;
                                editing: root.tr-key-editing;
                                key-status: root.tr-key-status;
                                key-error: root.tr-key-error;
                                key-input <=> root.tr-key-input;
                                test-text: root.tr-test-text;
                                test-busy: root.tr-test-busy;
                                save-key(k) => {
                                    root.tr-save-key(k);
                                }
                                replace-key => {
                                    root.tr-replace-key();
                                }
                                remove-key => {
                                    root.tr-remove-key();
                                }
                                test => {
                                    root.tr-test();
                                }
                            }
                            // section:4 translate-never-sent
                            TrNeverCard { }
                        }

                        // ---------------------------------------------------- About
                        if root.section == 5: VerticalLayout {
                            spacing: 16px;
                            Card {
                                // section:5 version
                                InfoRow {
                                    first: true;
                                    label: SText.version;
                                    value: root.version-text;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    padding-bottom: 8px;
                                    Button {
                                        text: SText.open-folder;
                                        kind: ButtonKind.ghost;
                                        clicked => {
                                            root.open-folder();
                                        }
                                    }
                                }
                            }
                            Card {
                                title: SText.updates-heading;
                                Note {
                                    text: SText.update-note;
                                    pad-bottom: 4px;
                                }
                                // section:5 auto-update
                                SettingRow {
                                    first: true;
                                    label: SText.update-auto;
                                    Switch {
                                        label: SText.update-auto;
                                        enabled: root.auto-update-enabled;
                                        checked <=> root.auto-update;
                                        toggled(v) => {
                                            root.auto-update-toggled(v);
                                        }
                                    }
                                }
                                // section:5 check-updates
                                SettingRow {
                                    label: SText.update-check;
                                    description: root.update-status;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: SText.update-check;
                                            enabled: !root.update-busy;
                                            clicked => {
                                                root.check-updates();
                                            }
                                        }
                                        if root.update-found: Button {
                                            text: SText.update-open;
                                            kind: ButtonKind.primary;
                                            clicked => {
                                                root.open-release();
                                            }
                                        }
                                    }
                                }
                            }
                            Card {
                                title: SText.caps-label;
                                // section:5 capabilities
                                InfoRow {
                                    first: true;
                                    label: SText.caps-label;
                                    value: root.caps-text;
                                }
                            }
                            Card {
                                title: SText.licences-label;
                                // section:5 licences
                                InfoRow {
                                    first: true;
                                    label: SText.licences-label;
                                    value: SText.licence-text + "\n" + SText.notices;
                                }
                                Note {
                                    text: SText.third-party;
                                    pad-top: 4px;
                                    pad-bottom: 8px;
                                }
                            }
                        }
                    }
                }

                // The result of the last action (saved, cleaned, backed up ...), on every section.
                if root.status != "": Rectangle {
                    height: status-text.preferred-height + 16px;
                    background: Theme.surface;
                    status-text := Text {
                        x: 24px;
                        y: 8px;
                        width: parent.width - 48px;
                        text: root.status;
                        color: root.status-error ? Theme.danger : Theme.success;
                        wrap: word-wrap;
                        accessible-role: text;
                    }
                }

                // The save bar: only after a change, and not on About (nothing to save there).
                if root.dirty && root.section != 5: Rectangle {
                    height: 52px;
                    background: Theme.raised;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: SText.unsaved;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            accessible-role: text;
                        }
                        Button {
                            text: SText.revert;
                            kind: ButtonKind.ghost;
                            clicked => {
                                root.revert();
                            }
                        }
                        SaveButton {
                            text: SText.save;
                            key: SText.key-ctrl-s;
                            enabled: root.can-save;
                            property <bool> want: root.return-to == 6;
                            changed want => {
                                if (self.want) {
                                    self.focus();
                                }
                            }
                            clicked => {
                                root.opener = 6;
                                root.save();
                            }
                        }
                    }
                }
            }
        }
    }

    // Built-in exclusion removal: asks first.
    ConfirmDialog {
        open: root.confirm-remove-text != "";
        title: SText.dlg-remove;
        body: root.confirm-remove-text;
        confirm-text: SText.remove;
        cancel-text: SText.cancel;
        confirmed => {
            root.confirm-remove();
        }
        cancelled => {
            root.cancel-remove();
        }
    }

    // Turning translate in place on for the first time asks for consent (Task 606, D-093).
    TrConsentDialog {
        open: root.tr-consent-open;
        confirmed => {
            root.tr-consent-confirm();
        }
        cancelled => {
            root.tr-consent-cancel();
        }
    }

    // Lowering a retention limit asks first.
    ConfirmDialog {
        open: root.limits-open;
        title: SText.dlg-limits;
        body: SText.limits-confirm;
        confirm-text: SText.save;
        cancel-text: SText.cancel;
        confirmed => {
            root.limits-confirm();
        }
        cancelled => {
            root.limits-cancel();
        }
    }

    // Clear history: asks first, with "keep pinned".
    ConfirmDialog {
        open: root.clear-open;
        title: SText.dlg-clear;
        body: root.clear-question;
        confirm-text: SText.clear-do;
        cancel-text: SText.cancel;
        danger: true;
        confirmed => {
            root.clear-confirm();
        }
        cancelled => {
            root.clear-cancel();
        }
        HorizontalLayout {
            spacing: 10px;
            Switch {
                label: SText.keep-pinned;
                checked <=> root.clear-keep-pinned;
                toggled(v) => {
                    root.clear-toggled(v);
                }
            }
            Text {
                text: SText.keep-pinned;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    // Delete old clips, remove orphaned files, compact: each asks first and names the count.
    ConfirmDialog {
        open: root.cleanup-open;
        title: SText.cleanup-heading;
        body: root.cleanup-question;
        confirm-text: SText.clear-do;
        cancel-text: SText.cancel;
        danger: true;
        confirmed => {
            root.cleanup-confirm();
        }
        cancelled => {
            root.cleanup-cancel();
        }
    }

    // Restore: replaces the whole history, so it always asks first (Task 405).
    ConfirmDialog {
        open: root.restore-open;
        title: SText.dlg-restore;
        body: root.restore-question;
        confirm-text: SText.restore-yes;
        cancel-text: SText.cancel;
        danger: true;
        confirmed => {
            root.restore-confirm();
        }
        cancelled => {
            root.restore-cancel();
        }
    }

    // Pick running app: program file names only. A list, not a question, so it keeps its own
    // panel on the same scrim.
    DialogScrim {
        open: root.picker-open;
        if root.picker-open: Rectangle {
            width: min(root.width - 40px, 420px);
            height: min(root.height - 40px, 420px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.canvas;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;
            accessible-role: groupbox;
            accessible-label: SText.pick-running;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Note {
                    text: SText.pick-note;
                }
                if root.picker-loading: Text {
                    text: SText.loading;
                    color: Theme.text-2;
                }
                if !root.picker-loading && root.picker.length == 0: Text {
                    text: SText.pick-none;
                    color: Theme.text-2;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: root.picker.length * 32px;
                    for p[pi] in root.picker: FocusScope {
                        y: pi * 32px;
                        height: 32px;
                        width: parent.width;
                        focus-on-click: false;
                        accessible-role: button;
                        accessible-label: p;
                        accessible-action-default => {
                            root.pick-app(pi);
                        }
                        key-pressed(e) => {
                            if (e.text == " " || e.text == Key.Return) {
                                root.pick-app(pi);
                                return accept;
                            }
                            reject
                        }
                        Rectangle {
                            border-radius: 6px;
                            background: pick-touch.has-hover ? Theme.surface : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                text: p;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            visible: parent.has-focus;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Theme.focus;
                            background: transparent;
                        }
                        pick-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pick-app(pi);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: SText.close;
                        clicked => {
                            root.close-picker();
                        }
                    }
                }
            }
        }
    }
}
