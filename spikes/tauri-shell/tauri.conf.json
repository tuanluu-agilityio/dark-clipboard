{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dark-clipboard-tauri-spike",
  "version": "0.0.0",
  "identifier": "dev.darkclipboard.spike",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Dark Clipboard spike",
        "width": 420,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
