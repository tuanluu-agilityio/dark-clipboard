{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkclipboard.dev/schemas/export.schema.json",
  "title": "Collection export manifest",
  "description": "Sensitive (masked) clips are never exported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_version",
    "created_at",
    "collection",
    "clips",
    "blobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "collection": {
      "$ref": "collection.schema.json"
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "clip.schema.json"
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "path",
          "size_bytes"
        ],
        "properties": {
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "path": {
            "type": "string",
            "pattern": "^blobs/[0-9a-f]{2}/[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
