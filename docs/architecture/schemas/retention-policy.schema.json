{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkclipboard.dev/schemas/retention-policy.schema.json",
  "title": "RetentionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "max_items",
    "max_age_days",
    "max_storage_mb",
    "keep_pinned",
    "keep_favorites",
    "sensitive_ttl_seconds",
    "image_max_mb",
    "text_max_kb"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "max_items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "0 = unlimited"
    },
    "max_age_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650,
      "description": "0 = unlimited"
    },
    "max_storage_mb": {
      "type": "integer",
      "minimum": 10,
      "maximum": 102400
    },
    "keep_pinned": {
      "const": true
    },
    "keep_favorites": {
      "type": "boolean"
    },
    "sensitive_ttl_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600
    },
    "image_max_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "text_max_kb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    }
  }
}
