{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkclipboard.dev/schemas/tag.schema.json",
  "title": "Tag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^A-Z\\s]+$",
      "description": "Lowercase; letters, digits, _ and - (enforced fully in darkclip-core)"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "clip_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
